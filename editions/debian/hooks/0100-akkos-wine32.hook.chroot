#!/bin/sh
# Akko's OS — suporte a programas Windows de 32 bits (multiarch i386).
# Muitos instaladores .exe ainda são 32 bits; o Wine precisa das bibliotecas i386.
set -e
echo "[akkos] habilitando arquitetura i386 para o Wine 32 bits"
dpkg --add-architecture i386
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y \
    wine32:i386 dxvk-wine32:i386 \
    libgl1-mesa-dri:i386 mesa-vulkan-drivers:i386 libvulkan1:i386
apt-get clean
dpkg -l 'wine32:i386' 'dxvk-wine32:i386' | tail -2
