#!/bin/sh
# Abre o instalador do Akko's OS (Calamares) quando o sistema roda sem instalar.
if [ ! -d /run/live/medium ] || ! command -v calamares >/dev/null 2>&1; then
    zenity --info --title="Akko's OS" --width=380 \
        --text="O Akko's OS já está instalado neste computador." 2>/dev/null
    exit 0
fi
if pgrep -x calamares >/dev/null; then
    wmctrl -a "Instalador" 2>/dev/null || wmctrl -xa calamares 2>/dev/null
    exit 0
fi
akko-sound click 2>/dev/null
# Calamares precisa de administrador; no sistema live o usuário tem sudo sem senha
if sudo -n true 2>/dev/null; then
    exec sudo -E QT_QPA_PLATFORMTHEME=gtk3 calamares "$@"
fi
exec pkexec env DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" QT_QPA_PLATFORMTHEME=gtk3 calamares "$@"
