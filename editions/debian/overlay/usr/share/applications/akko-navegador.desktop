[Desktop Entry]
Type=Application
Name=Navegador
GenericName=Navegador web
Comment=Navegue na internet (Chromium em sandbox)
Exec=akko-navegador %U
Icon=chromium
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Keywords=internet;web;chrome;chromium;
StartupNotify=true
StartupWMClass=chromium
Actions=anonima;

[Desktop Action anonima]
Name=Janela anônima
Exec=akko-navegador --incognito
