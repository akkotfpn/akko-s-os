    def executar_nova(self):
        d = Gtk.Dialog(title="Criar nova tarefa", transient_for=self, modal=True)
        d.add_button("Cancelar", Gtk.ResponseType.CANCEL)
        d.add_button("OK", Gtk.ResponseType.OK).get_style_context().add_class("suggested-action")
        d.set_default_response(Gtk.ResponseType.OK)
        area = d.get_content_area()
        area.set_spacing(8)
        area.set_margin_start(14)
        area.set_margin_end(14)
        area.set_margin_top(14)
        area.add(Gtk.Label(label="Digite o nome de um programa, pasta ou arquivo (.exe também funciona):", xalign=0))
        campo = Gtk.Entry(activates_default=True, width_chars=46)
        area.add(campo)
        d.show_all()
        if d.run() == Gtk.ResponseType.OK and campo.get_text().strip():
            texto = os.path.expanduser(campo.get_text().strip())
            if os.path.isdir(texto):
                ak.executar_destacado(["akko-arquivos", texto])
            elif texto.lower().endswith((".exe", ".msi")):
                ak.executar_destacado(["win-launcher", texto])
            elif os.path.isfile(texto) and not os.access(texto, os.X_OK):
                ak.executar_destacado(["xdg-open", texto])
            else:
                try:
                    GLib.spawn_command_line_async(texto)
                except GLib.Error as erro:
                    self._confirmar("Não foi possível executar", erro.message, so_ok=True)
        d.destroy()

    def _confirmar(self, titulo, texto, perigoso=False, so_ok=False):
        d = Gtk.MessageDialog(transient_for=self, modal=True, text=titulo,
                              message_type=Gtk.MessageType.WARNING if perigoso else Gtk.MessageType.QUESTION,
                              buttons=Gtk.ButtonsType.OK if so_ok else Gtk.ButtonsType.NONE)
        d.format_secondary_text(texto)
        if not so_ok:
            d.add_button("Cancelar", Gtk.ResponseType.CANCEL)
            b = d.add_button("Continuar", Gtk.ResponseType.OK)
            b.get_style_context().add_class("destructive-action" if perigoso else "suggested-action")
        r = d.run()
        d.destroy()
        return r == Gtk.ResponseType.OK

