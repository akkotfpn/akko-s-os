    def finalizar_selecionado(self):
        pid = self._pid_selecionado()
        if pid:
            modelo, it = self.tv_proc.get_selection().get_selected()
            arvore = modelo.iter_has_child(it)
            self.finalizar(pid, arvore=arvore)

    def finalizar(self, pid, arvore=False):
        try:
            p = psutil.Process(pid)
            alvos = (p.children(recursive=True) if arvore else []) + [p]
            nome = p.name()
        except psutil.NoSuchProcess:
            return
        if pid == os.getpid() or nome in ("Xorg", "openbox", "lightdm", "systemd", "akko-painel"):
            if not self._confirmar(f"Finalizar “{nome}”?",
                                   "Este processo é parte do sistema ou da sessão. Finalizá-lo pode fechar a "
                                   "área de trabalho ou travar o computador.", perigoso=True):
                return
        for a in alvos:
            try:
                a.terminate()
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                pass
        _gone, vivos = psutil.wait_procs(alvos, timeout=3)
        negados = []
        for a in vivos:
            try:
                a.kill()
            except psutil.AccessDenied:
                negados.append(a.pid)
            except psutil.NoSuchProcess:
                pass
        if negados:
            if self._confirmar("Precisa de permissão de administrador",
                               f"“{nome}” pertence a outro usuário ou ao sistema. Finalizar como administrador?"):
                subprocess.run(["pkexec", "kill", "-9", *map(str, negados)])
        ak.tocar("click")
        self.atualizar()

    def prioridade(self, pid, valor):
        try:
            psutil.Process(pid).nice(valor)
        except psutil.AccessDenied:
            subprocess.run(["pkexec", "renice", "-n", str(valor), "-p", str(pid)])
        except psutil.NoSuchProcess:
            pass

    def abrir_local(self, pid):
        try:
            exe = psutil.Process(pid).exe()
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            return
        if exe:
            ak.executar_destacado(["akko-arquivos", os.path.dirname(exe)])

    def copiar_cmd(self, pid):
        try:
            Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(" ".join(psutil.Process(pid).cmdline()), -1)
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            pass

