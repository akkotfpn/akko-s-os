def hex_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))


def fmt_bytes(n):
    return ak.formatar_tamanho(n)


def fmt_taxa(n):
    return f"{ak.formatar_tamanho(n)}/s" if n >= 1 else "0 B/s"


def fmt_tempo(seg):
    d, r = divmod(int(seg), 86400)
    h, r = divmod(r, 3600)
    m, s = divmod(r, 60)
    return f"{d}:{h:02d}:{m:02d}:{s:02d}"


# ==================================================================== gráfico

class Grafico(Gtk.DrawingArea):
    """Gráfico de área com grade, estilo Gerenciador de Tarefas."""

    def __init__(self, cor, maximo=100.0, mini=False, series=1):
        super().__init__()
        self.cor = hex_rgb(cor)
        self.maximo = maximo
        self.auto = maximo is None
        self.mini = mini
        self.dados = [collections.deque([0.0] * HIST, maxlen=HIST) for _ in range(series)]
        self.set_size_request(80 if mini else 300, 40 if mini else 160)
        self.connect("draw", self._desenhar)

    def adicionar(self, *valores):
        for serie, v in zip(self.dados, valores):
            serie.append(max(0.0, float(v)))
        self.queue_draw()

    def _desenhar(self, _w, cr):
        w, h = self.get_allocated_width(), self.get_allocated_height()
        r, g, b = self.cor
        maximo = self.maximo
        if self.auto:
            maximo = max(1.0, max(max(s) for s in self.dados) * 1.15)
        cr.set_source_rgba(r, g, b, 0.06)
        cr.rectangle(0, 0, w, h)
        cr.fill()
        if not self.mini:
            cr.set_source_rgba(r, g, b, 0.18)
            cr.set_line_width(1)
            for i in range(1, 10):
                x = int(w * i / 10) + 0.5
                cr.move_to(x, 0)
                cr.line_to(x, h)
            for i in range(1, 5):
                y = int(h * i / 5) + 0.5
                cr.move_to(0, y)
                cr.line_to(w, y)
            cr.stroke()
        for idx, serie in enumerate(self.dados):
            passo = w / (HIST - 1)
            cr.move_to(0, h)
            for i, v in enumerate(serie):
                cr.line_to(i * passo, h - min(v / maximo, 1.0) * (h - 2))
            cr.line_to(w, h)
            cr.close_path()
            alfa = 0.30 if idx == 0 else 0.0
            cr.set_source_rgba(r, g, b, alfa)
            cr.fill_preserve() if alfa else None
            cr.new_path()
            for i, v in enumerate(serie):
                y = h - min(v / maximo, 1.0) * (h - 2)
                (cr.move_to if i == 0 else cr.line_to)(i * passo, y)
            cr.set_source_rgba(r, g, b, 1.0)
            cr.set_line_width(1.5)
            if idx == 1:
                cr.set_dash([4, 3])
            cr.stroke()
            cr.set_dash([])
        cr.set_source_rgba(r, g, b, 0.7)
        cr.set_line_width(1)
        cr.rectangle(0.5, 0.5, w - 1, h - 1)
        cr.stroke()
        return False


# ==================================================================== GPUs

class GPU:
    """Leitura de uso da placa de vídeo pelo sysfs (AMD/Intel) ou nvidia-smi."""

    def __init__(self, card):
        self.card = card
        self.dev = os.path.realpath(os.path.join(card, "device"))
        self.vendor = self._ler(os.path.join(self.dev, "vendor"))
        self.driver = os.path.basename(os.path.realpath(os.path.join(self.dev, "driver"))) \
            if os.path.exists(os.path.join(self.dev, "driver")) else "?"
        self.nome = self._nome_pci()
        self.uso = None
        self.vram_usada = self.vram_total = None
        self.temp = None
        self.freq = None
        self._nv = None

    @staticmethod
    def _ler(caminho):
        try:
            with open(caminho) as f:
                return f.read().strip()
        except OSError:
            return None

    def _nome_pci(self):
        slot = os.path.basename(self.dev)
        try:
            saida = subprocess.run(["lspci", "-s", slot], capture_output=True, text=True, timeout=3).stdout
            if ":" in saida:
                nome = saida.split(":", 2)[-1].strip()
                return nome.split("(rev")[0].strip()
        except (OSError, subprocess.TimeoutExpired):
            pass
        marca = {"0x1002": "AMD", "0x10de": "NVIDIA", "0x8086": "Intel", "0x1af4": "VirtIO", "0x1234": "QEMU",
                 "0x15ad": "VMware"}.get(self.vendor, "Placa de vídeo")
        return f"{marca} ({self.driver})"

    def amostrar(self):
        d = self.dev
        busy = self._ler(os.path.join(d, "gpu_busy_percent"))           # amdgpu
        if busy is not None:
            self.uso = float(busy)
            u, t = self._ler(os.path.join(d, "mem_info_vram_used")), self._ler(os.path.join(d, "mem_info_vram_total"))
            if u and t:
                self.vram_usada, self.vram_total = int(u), int(t)
        elif self.driver == "nvidia" and shutil.which("nvidia-smi"):
            try:
                saida = subprocess.run(["nvidia-smi", "--query-gpu=pci.bus_id,utilization.gpu,memory.used,memory.total,"
                                        "temperature.gpu,clocks.gr", "--format=csv,noheader,nounits"],
                                       capture_output=True, text=True, timeout=3).stdout
                slot = os.path.basename(d).lower()
                for linha in saida.splitlines():
                    p = [x.strip() for x in linha.split(",")]
                    if len(p) >= 6 and p[0].lower().endswith(slot[-7:]):
                        self.uso, self.vram_usada, self.vram_total = float(p[1]), int(p[2]) << 20, int(p[3]) << 20
                        self.temp, self.freq = float(p[4]), float(p[5])
            except (OSError, ValueError, subprocess.TimeoutExpired):
                pass
        else:                                                              # i915 / xe: só frequência
            for arq in (os.path.join(self.card, "gt_act_freq_mhz"), *glob.glob(os.path.join(d, "tile0/gt0/freq0/act_freq"))):
                f = self._ler(arq)
                if f:
                    self.freq = float(f)
                    mx = self._ler(arq.replace("act_freq", "max_freq").replace("gt_act", "gt_max"))
                    if mx and float(mx) > 0:
                        self.uso = min(100.0, self.freq / float(mx) * 100)
                    break
        for hw in glob.glob(os.path.join(d, "hwmon", "hwmon*", "temp1_input")):
            t = self._ler(hw)
            if t:
                self.temp = int(t) / 1000


def listar_gpus():
    gpus = []
    for card in sorted(glob.glob("/sys/class/drm/card[0-9]")):
        if os.path.exists(os.path.join(card, "device", "vendor")):
            gpus.append(GPU(card))
    return gpus


