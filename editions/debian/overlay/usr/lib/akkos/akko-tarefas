    def _tecla(self, _w, ev):
        ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
        pagina = self.paginas.get_visible_child_name()
        if ctrl and ev.keyval in (Gdk.KEY_f, Gdk.KEY_F):
            self.busca.grab_focus()
            return True
        if ev.keyval == Gdk.KEY_F5:
            self.atualizar()
            return True
        if ev.keyval == Gdk.KEY_Delete and not isinstance(self.get_focus(), Gtk.Entry):
            if pagina == "processos":
                self.finalizar_selecionado()
            elif pagina == "detalhes":
                self.finalizar_detalhe(False)
            return True
        return False

