    def _atualizar_desempenho(self, lista):
        agora = time.monotonic()
        dt = max(0.2, agora - self.t_ant)
        self.t_ant = agora
        d = self.disp
        # CPU
        por = psutil.cpu_percent(percpu=True)
        total = sum(por) / len(por) if por else 0
        c = d["cpu"]
        c["mini"].adicionar(total)
        c["grande"].adicionar(total)
        for g, v in zip(c["nucleos"], por):
            g.adicionar(v)
        f = psutil.cpu_freq()
        c["resumo"].set_text(f"{total:.0f}%  {f.current / 1000:.2f} GHz" if f else f"{total:.0f}%")
        v = c["valores"]
        v["uso"].set_text(f"{total:.0f}%")
        v["freq"].set_text(f"{f.current / 1000:.2f} GHz" if f else "—")
        v["procs"].set_text(str(len(lista)))
        v["threads"].set_text(str(sum(i.get("num_threads") or 0 for i in lista)))
        v["uptime"].set_text(fmt_tempo(time.time() - psutil.boot_time()))
        v["nucleos"].set_text(str(self.ncpu))
        v["fisicos"].set_text(str(psutil.cpu_count(logical=False) or "—"))
        # memória
        vm, sw = psutil.virtual_memory(), psutil.swap_memory()
        m = d["mem"]
        m["mini"].adicionar(vm.percent)
        m["grande"].adicionar(vm.percent)
        m["resumo"].set_text(f"{fmt_bytes(vm.used)}/{fmt_bytes(vm.total)} ({vm.percent:.0f}%)")
        m["valores"]["uso"].set_text(fmt_bytes(vm.used))
        m["valores"]["disp"].set_text(fmt_bytes(vm.available))
        m["valores"]["cache"].set_text(fmt_bytes(getattr(vm, "cached", 0) + getattr(vm, "buffers", 0)))
        m["valores"]["swap"].set_text(f"{fmt_bytes(sw.used)} de {fmt_bytes(sw.total)}" if sw.total else "sem swap")
        m["valores"]["total"].set_text(fmt_bytes(vm.total))
        # discos
        io = psutil.disk_io_counters(perdisk=True) or {}
        for nome in self.discos:
            a, b = self.disco_ant.get(nome), io.get(nome)
            if not (a and b):
                continue
            ativo = min(100.0, (getattr(b, "busy_time", 0) - getattr(a, "busy_time", 0)) / (dt * 10))
            leit = (b.read_bytes - a.read_bytes) / dt
            grav = (b.write_bytes - a.write_bytes) / dt
            x = d[f"disco:{nome}"]
            x["mini"].adicionar(ativo)
            x["grande"].adicionar(ativo)
            x["resumo"].set_text(f"{ativo:.0f}%")
            x["valores"]["ativo"].set_text(f"{ativo:.0f}%")
            x["valores"]["leit"].set_text(fmt_taxa(leit))
            x["valores"]["grav"].set_text(fmt_taxa(grav))
            tam = GPU._ler(f"/sys/block/{nome}/size")
            x["valores"]["cap"].set_text(fmt_bytes(int(tam) * 512) if tam else "—")
        self.disco_ant = io
        # rede
        nio = psutil.net_io_counters(pernic=True) or {}
        ends = psutil.net_if_addrs()
        stats = psutil.net_if_stats()
        for nome in self.redes:
            a, b = self.rede_ant.get(nome), nio.get(nome)
            if not (a and b):
                continue
            env = (b.bytes_sent - a.bytes_sent) / dt
            rec = (b.bytes_recv - a.bytes_recv) / dt
            x = d[f"rede:{nome}"]
            x["mini"].adicionar(rec * 8 / 1000, env * 8 / 1000)
            x["grande"].adicionar(rec * 8 / 1000, env * 8 / 1000)
            x["resumo"].set_text(f"E: {fmt_taxa(env)}  R: {fmt_taxa(rec)}")
            x["valores"]["env"].set_text(f"{env * 8 / 1000:.0f} Kbps")
            x["valores"]["rec"].set_text(f"{rec * 8 / 1000:.0f} Kbps")
            ip = next((e.address for e in ends.get(nome, []) if e.family.name == "AF_INET"), "—")
            x["valores"]["ip"].set_text(ip)
            st = stats.get(nome)
            x["valores"]["link"].set_text(f"{st.speed} Mbps" if st and st.speed else ("desconectado" if st and not st.isup else "—"))
        self.rede_ant = nio
        # GPUs (amostradas em segundo plano: nvidia-smi pode demorar)
        for i, g in enumerate(self.gpus):
            x = d[f"gpu:{i}"]
            uso = g.uso if g.uso is not None else 0
            x["mini"].adicionar(uso)
            x["grande"].adicionar(uso)
            x["resumo"].set_text(f"{uso:.0f}%" + (f"  {g.temp:.0f} °C" if g.temp else "") if g.uso is not None
                                 else "uso indisponível")
            x["valores"]["uso"].set_text(f"{uso:.0f}%" if g.uso is not None else "indisponível neste driver")
            x["valores"]["vram"].set_text(f"{fmt_bytes(g.vram_usada)} / {fmt_bytes(g.vram_total)}"
                                          if g.vram_total else "—")
            x["valores"]["temp"].set_text(f"{g.temp:.0f} °C" if g.temp else "—")
            x["valores"]["freq"].set_text(f"{g.freq:.0f} MHz" if g.freq else "—")

    def _amostrar_gpus(self):
        for g in self.gpus:
            g.amostrar()
        return False

    # ================================================================ Inicialização

    def _pagina_inicio(self):
        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        b = Gtk.Button(label="Ativar / Desativar")
        b.connect("clicked", lambda *_: self.alternar_inicio())
        caixa.pack_start(self._titulo("Aplicativos de inicialização", b), False, False, 0)
        # nome, comando, status_txt, ativo, arquivo, icone
        self.loja_ini = Gtk.ListStore(str, str, str, bool, str, str)
        tv = Gtk.TreeView(model=self.loja_ini)
        col = Gtk.TreeViewColumn("Nome")
        ri = Gtk.CellRendererPixbuf()
        col.pack_start(ri, False)
        col.add_attribute(ri, "icon-name", 5)
        rt = Gtk.CellRendererText()
        col.pack_start(rt, True)
        col.add_attribute(rt, "text", 0)
        col.set_expand(True)
        tv.append_column(col)
        tg = Gtk.CellRendererToggle()
        tg.connect("toggled", lambda _r, path: self.alternar_inicio(path))
        tv.append_column(Gtk.TreeViewColumn("Ativo", tg, active=3))
        tv.append_column(Gtk.TreeViewColumn("Status", Gtk.CellRendererText(), text=2))
        tv.append_column(Gtk.TreeViewColumn("Comando", Gtk.CellRendererText(ellipsize=Pango.EllipsizeMode.END), text=1))
        self.tv_ini = tv
        r = Gtk.ScrolledWindow(vexpand=True)
        r.add(tv)
        caixa.pack_start(r, True, True, 0)
        nota = Gtk.Label(label="Itens da sessão do Akko's OS (painel, sons, área de trabalho) não aparecem aqui "
                               "para não serem desligados por engano.", xalign=0, wrap=True, margin=10)
        nota.get_style_context().add_class("akkos-muted")
        caixa.pack_start(nota, False, False, 0)
        return caixa

    def carregar_inicio(self):
        self.loja_ini.clear()
        usuario = os.path.join(GLib.get_user_config_dir(), "autostart")
        vistos = {}
        for pasta in ("/etc/xdg/autostart", usuario):
            for arq in sorted(glob.glob(os.path.join(pasta, "*.desktop"))):
                vistos[os.path.basename(arq)] = arq
        for nome, arq in sorted(vistos.items()):
            kf = GLib.KeyFile()
            try:
                kf.load_from_file(arq, GLib.KeyFileFlags.NONE)
            except GLib.Error:
                continue

            def ler(k, padrao=""):
                try:
                    return kf.get_locale_string("Desktop Entry", k, None)
                except GLib.Error:
                    return padrao
            oculto = ler("Hidden", "false").lower() == "true"
            so_em = ler("OnlyShowIn", "")
            if so_em and "akkos" not in so_em.lower() and "openbox" not in so_em.lower() and "xfce" not in so_em.lower():
                continue
            if ler("NoDisplay", "false").lower() == "true" and not oculto:
                continue
            self.loja_ini.append([ler("Name", nome), ler("Exec"), "Desabilitado" if oculto else "Habilitado",
                                  not oculto, nome, ler("Icon", "application-x-executable") or "application-x-executable"])

    def alternar_inicio(self, path=None):
        if path is None:
            modelo, it = self.tv_ini.get_selection().get_selected()
            if not it:
                return
        else:
            it = self.loja_ini.get_iter(path)
        nome, ativo = self.loja_ini[it][4], self.loja_ini[it][3]
        usuario = os.path.join(GLib.get_user_config_dir(), "autostart")
        os.makedirs(usuario, exist_ok=True)
        destino = os.path.join(usuario, nome)
        origem = destino if os.path.exists(destino) else os.path.join("/etc/xdg/autostart", nome)
        kf = GLib.KeyFile()
        try:
            kf.load_from_file(origem, GLib.KeyFileFlags.KEEP_COMMENTS | GLib.KeyFileFlags.KEEP_TRANSLATIONS)
        except GLib.Error:
            return
        kf.set_string("Desktop Entry", "Hidden", "true" if ativo else "false")
        kf.save_to_file(destino)
        ak.tocar("click")
        self.carregar_inicio()

    # ================================================================ Detalhes

    def _pagina_detalhes(self):
        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        b = Gtk.Button(label="Finalizar tarefa")
        b.get_style_context().add_class("destructive-action")
        b.connect("clicked", lambda *_: self.finalizar_detalhe(False))
        caixa.pack_start(self._titulo("Detalhes", b), False, False, 0)
        # pid, nome, status, usuario, cpu, cpu_txt, mem, mem_txt, threads, prioridade, comando
        self.loja_det = Gtk.ListStore(int, str, str, str, float, str, GObject.TYPE_INT64, str, int, int, str)
        self.ord_det = Gtk.TreeModelSort(model=self.loja_det)
        self.ord_det.set_sort_column_id(4, Gtk.SortType.DESCENDING)
        tv = Gtk.TreeView(model=self.ord_det)
        for titulo, txt, ordem, larg in (("Nome", 1, 1, 180), ("PID", 0, 0, 70), ("Status", 2, 2, 90),
                                         ("Usuário", 3, 3, 90), ("CPU", 5, 4, 70), ("Memória", 7, 6, 90),
                                         ("Threads", 8, 8, 70), ("Prioridade", 9, 9, 80), ("Linha de comando", 10, 10, 300)):
            r = Gtk.CellRendererText(ellipsize=Pango.EllipsizeMode.END if txt in (1, 10) else Pango.EllipsizeMode.NONE)
            c = Gtk.TreeViewColumn(titulo, r, text=txt)
            c.set_sort_column_id(ordem)
            c.set_resizable(True)
            c.set_min_width(larg)
            if txt == 10:
                c.set_expand(True)
            tv.append_column(c)
        tv.connect("button-press-event", self._det_clique)
        self.tv_det = tv
        r = Gtk.ScrolledWindow(vexpand=True)
        r.add(tv)
        caixa.pack_start(r, True, True, 0)
        return caixa

    def _atualizar_detalhes(self, lista):
        modelo, it = self.tv_det.get_selection().get_selected()
        sel = modelo[it][0] if it else None
        self.loja_det.clear()
        estados = {"running": "Em execução", "sleeping": "Em espera", "disk-sleep": "Aguardando disco",
                   "stopped": "Suspenso", "zombie": "Zumbi", "idle": "Ocioso"}
        for i in lista:
            cmd = " ".join(i["cmdline"] or []) or f"[{i['name']}]"
            self.loja_det.append([i["pid"], i["name"] or "?", estados.get(i["status"], i["status"] or ""),
                                  i["username"] or "?", i["cpu"], f"{i['cpu']:.1f}", i["mem"], fmt_bytes(i["mem"]),
                                  i["num_threads"] or 0, i["nice"] if i["nice"] is not None else 0, cmd])
        if sel:
            for linha in self.ord_det:
                if linha[0] == sel:
                    self.tv_det.get_selection().select_path(linha.path)
                    break

    def _det_pid(self):
        modelo, it = self.tv_det.get_selection().get_selected()
        return modelo[it][0] if it else None

    def _det_clique(self, tv, ev):
        if ev.type != Gdk.EventType.BUTTON_PRESS or ev.button != 3:
            return False
        hit = tv.get_path_at_pos(int(ev.x), int(ev.y))
        if hit:
            tv.get_selection().select_path(hit[0])
            pid = self._det_pid()
            if pid:
                self._menu_pid(pid, ev)
        return True

    def finalizar_detalhe(self, arvore):
        pid = self._det_pid()
        if pid:
            self.finalizar(pid, arvore)

    # ================================================================ Serviços

    def _pagina_servicos(self):
        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        acoes = Gtk.Box(spacing=6)
        for rotulo, verbo in (("Iniciar", "start"), ("Parar", "stop"), ("Reiniciar", "restart")):
            b = Gtk.Button(label=rotulo)
            b.connect("clicked", lambda *_, v=verbo: self.servico(v))
            acoes.pack_start(b, False, False, 0)
        caixa.pack_start(self._titulo("Serviços", acoes), False, False, 0)
        # nome, descricao, estado, sub, cor
        self.loja_srv = Gtk.ListStore(str, str, str, str)
        ordem = Gtk.TreeModelSort(model=self.loja_srv)
        ordem.set_sort_column_id(0, Gtk.SortType.ASCENDING)
        tv = Gtk.TreeView(model=ordem)
        for titulo, col in (("Nome", 0), ("Descrição", 1), ("Status", 2), ("Detalhe", 3)):
            c = Gtk.TreeViewColumn(titulo, Gtk.CellRendererText(ellipsize=Pango.EllipsizeMode.END), text=col)
            c.set_sort_column_id(col)
            c.set_resizable(True)
            c.set_min_width(120 if col != 1 else 300)
            tv.append_column(c)
        self.tv_srv = tv
        r = Gtk.ScrolledWindow(vexpand=True)
        r.add(tv)
        caixa.pack_start(r, True, True, 0)
        return caixa

    def carregar_servicos(self):
        self.servicos_carregados = True
        self.loja_srv.clear()
        try:
            saida = subprocess.run(["systemctl", "list-units", "--type=service", "--all", "--no-legend", "--plain",
                                    "--no-pager"], capture_output=True, text=True, timeout=10).stdout
        except (OSError, subprocess.TimeoutExpired):
            return
        traducao = {"active": "Em execução", "inactive": "Parado", "failed": "Falhou", "activating": "Iniciando",
                    "deactivating": "Parando"}
        for linha in saida.splitlines():
            p = linha.split(None, 4)
            if len(p) < 4 or not p[0].endswith(".service"):
                continue
            self.loja_srv.append([p[0][:-8], p[4] if len(p) > 4 else "", traducao.get(p[2], p[2]), p[3]])

    def servico(self, verbo):
        modelo, it = self.tv_srv.get_selection().get_selected()
        if not it:
            return
        nome = modelo[it][0] + ".service"
        r = subprocess.run(["pkexec", "systemctl", verbo, nome], capture_output=True, text=True)
        if r.returncode not in (0, 126, 127):
            self._confirmar("Não foi possível alterar o serviço", (r.stderr or "").strip()[:400], so_ok=True)
        self.carregar_servicos()

    # ================================================================ ciclo

    def atualizar(self):
        lista = self._coletar()
        self._atualizar_desempenho(lista)
        pagina = self.paginas.get_visible_child_name()
        if pagina == "processos" or not hasattr(self, "_primeira"):
            self._atualizar_processos(lista)
            self._primeira = True
        if pagina == "detalhes":
            self._atualizar_detalhes(lista)
        threading.Thread(target=self._amostrar_gpus, daemon=True).start()
        return False


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.akkos.Tarefas", flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.janela = None

    def do_activate(self):
        if self.janela is None:
            ak.aplicar_css(CSS)
            Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", True)
            self.janela = Janela(self)
            self.janela.show_all()
        self.janela.present()


PAGINA_INICIAL = None

if __name__ == "__main__":
    args = sys.argv[:]
    for chave in ("processos", "desempenho", "inicializacao", "detalhes", "servicos"):
        if f"--{chave}" in args:
            PAGINA_INICIAL = chave
            args.remove(f"--{chave}")
    sys.exit(App().run(args))
