    def _fmt_nome(self, _col, cell, modelo, it, *_):
        grupo = modelo[it][12]
        cell.set_property("text", modelo[it][0])
        cell.set_property("weight", 700 if grupo else 400)

    def _proc_visivel(self, modelo, it, *_):
        termo = self.busca.get_text().strip().casefold()
        if not termo or modelo[it][12]:
            return True
        if termo in modelo[it][0].casefold() or termo == str(modelo[it][1]):
            return True
        filho = modelo.iter_children(it)
        while filho:
            if termo in modelo[filho][0].casefold() or termo == str(modelo[filho][1]):
                return True
            filho = modelo.iter_next(filho)
        return False

    def _cor_calor(self, frac):
        """Cor de fundo da célula: quanto mais uso, mais intensa (como no Windows)."""
        if frac < 0.02:
            return None
        r, g, b = hex_rgb(PAL["brand"]["indigo"])
        a = 0.12 + min(frac, 1.0) * 0.55
        bg = hex_rgb(PAL["dark"]["background"])
        mix = [int((c * a + f * (1 - a)) * 255) for c, f in zip((r, g, b), bg)]
        return "#%02x%02x%02x" % tuple(mix)

    def _janelas_por_pid(self):
        apps = {}
        if not self.tela_wnck:
            return apps
        self.tela_wnck.force_update()
        for j in self.tela_wnck.get_windows():
            if j.get_window_type() not in (Wnck.WindowType.NORMAL, Wnck.WindowType.DIALOG):
                continue
            pid = j.get_pid()
            if pid <= 0:
                continue
            nome = j.get_class_group_name() or j.get_name()
            apps.setdefault(pid, (nome, j.get_name()))
        return apps

    def _coletar(self):
        agora = time.monotonic()
        dt = max(0.2, agora - self.t_ant)
        lista = []
        for p in psutil.process_iter(["pid", "ppid", "name", "username", "status", "memory_info", "num_threads",
                                      "cmdline", "exe", "uids", "nice"]):
            try:
                info = p.info
                cpu = p.cpu_percent(None) / self.ncpu
                io = None
                try:
                    c = p.io_counters()
                    total = c.read_bytes + c.write_bytes
                    ant = self.io_proc_ant.get(p.pid)
                    io = (total - ant) / dt if ant is not None else 0.0
                    self.io_proc_ant[p.pid] = total
                except (psutil.AccessDenied, AttributeError, psutil.NoSuchProcess):
                    pass
                info["cpu"] = cpu
                info["io"] = io or 0.0
                info["mem"] = info["memory_info"].rss if info["memory_info"] else 0
                lista.append(info)
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                continue
        vivos = {i["pid"] for i in lista}
        for pid in list(self.io_proc_ant):
            if pid not in vivos:
                del self.io_proc_ant[pid]
        return lista

    def _atualizar_processos(self, lista):
        por_pid = {i["pid"]: i for i in lista}
        filhos = collections.defaultdict(list)
        for i in lista:
            filhos[i["ppid"]].append(i["pid"])
        janelas = self._janelas_por_pid()

        def arvore_de(pid):
            pilha, saida = [pid], []
            while pilha:
                x = pilha.pop()
                saida.append(x)
                pilha.extend(filhos.get(x, []))
            return saida

        apps = {}
        usados = set()
        for pid, (nome, titulo) in janelas.items():
            if pid not in por_pid:
                continue
            membros = [m for m in arvore_de(pid) if m in por_pid]
            apps[pid] = (nome, titulo, membros)
            usados.update(membros)
        fundo = [i for i in lista if i["pid"] not in usados and (i["uids"] and i["uids"].real == self.uid)]
        sistema = [i for i in lista if i["pid"] not in usados and not (i["uids"] and i["uids"].real == self.uid)]

        sel = self._pid_selecionado()
        expandidos = set()
        for g, it in self.grupos.items():
            path = self.arvore.get_path(it)
            p_f = self.filtro_proc.convert_child_path_to_path(path)
            if p_f:
                p_o = self.ord_proc.convert_child_path_to_path(p_f)
                if p_o and self.tv_proc.row_expanded(p_o):
                    expandidos.add(g)
        primeira = not self.grupos
        self.arvore.clear()
        self.grupos = {}

        def linha(parent, nome, pid, cpu, mem, io, status, icone, grupo=False):
            return self.arvore.append(parent, [nome, pid, cpu, mem, io, f"{cpu:.1f}%" if not grupo or cpu else "",
                                               fmt_bytes(mem) if mem else "", fmt_taxa(io) if io else ("" if grupo else "0 B/s"),
                                               status, icone, self._cor_calor(cpu / 100 * 4) if not grupo else None,
                                               self._cor_calor(mem / psutil.virtual_memory().total * 8) if not grupo else None,
                                               grupo])

        status_txt = {"running": "Em execução", "sleeping": "", "disk-sleep": "Aguardando disco", "stopped": "Suspenso",
                      "zombie": "Zumbi", "idle": ""}

        def grupo(chave, titulo, itens_count):
            it = linha(None, f"{titulo} ({itens_count})", -1, 0, 0, 0, "", None, grupo=True)
            self.grupos[chave] = it
            return it

        g = grupo("apps", "Aplicativos", len(apps))
        for pid, (nome, titulo, membros) in sorted(apps.items(), key=lambda x: x[1][0].casefold()):
            cpu = sum(por_pid[m]["cpu"] for m in membros)
            mem = sum(por_pid[m]["mem"] for m in membros)
            io = sum(por_pid[m]["io"] for m in membros)
            rot = f"{nome}" + (f" ({len(membros)})" if len(membros) > 1 else "")
            it = linha(g, rot, pid, cpu, mem, io, status_txt.get(por_pid[pid]["status"], ""), self._icone_app(por_pid[pid], nome))
            if len(membros) > 1:
                for m in membros:
                    i = por_pid[m]
                    linha(it, i["name"], m, i["cpu"], i["mem"], i["io"], status_txt.get(i["status"], ""), "application-x-executable")
        g = grupo("fundo", "Processos em segundo plano", len(fundo))
        for i in sorted(fundo, key=lambda x: -x["cpu"]):
            linha(g, i["name"], i["pid"], i["cpu"], i["mem"], i["io"], status_txt.get(i["status"], ""), "application-x-executable")
        g = grupo("sistema", "Processos do sistema", len(sistema))
        for i in sorted(sistema, key=lambda x: -x["cpu"]):
            linha(g, i["name"], i["pid"], i["cpu"], i["mem"], i["io"], status_txt.get(i["status"], ""), "system-run")

        for chave, it in self.grupos.items():
            if primeira and chave in ("apps", "fundo") or chave in expandidos:
                path = self.arvore.get_path(it)
                p_f = self.filtro_proc.convert_child_path_to_path(path)
                if p_f:
                    p_o = self.ord_proc.convert_child_path_to_path(p_f)
                    if p_o:
                        self.tv_proc.expand_row(p_o, False)
        if sel:
            self._selecionar_pid(sel)
        vm = psutil.virtual_memory()
        self.resumo.set_text(f"{len(lista)} processos    CPU {psutil.cpu_percent():.0f}%    "
                             f"Memória {vm.percent:.0f}% ({fmt_bytes(vm.used)} de {fmt_bytes(vm.total)})")

    def _icone_app(self, info, nome):
        chave = (nome or "").lower()
        if chave in self.icones_app:
            return self.icones_app[chave]
        icone = "application-x-executable"
        tema = Gtk.IconTheme.get_default()
        for candidato in (chave, chave.replace(" ", "-"), (info.get("name") or "").lower()):
            if candidato and tema.has_icon(candidato):
                icone = candidato
                break
        else:
            for app in Gio.AppInfo.get_all():
                ex = (app.get_executable() or "").split("/")[-1].lower()
                if ex and (ex == (info.get("name") or "").lower() or app.get_name().lower() == chave):
                    gi_ = app.get_icon()
                    if isinstance(gi_, Gio.ThemedIcon) and gi_.get_names():
                        icone = gi_.get_names()[0]
                    break
        self.icones_app[chave] = icone
        return icone

    def _pid_selecionado(self):
        modelo, it = self.tv_proc.get_selection().get_selected()
        if it and modelo[it][1] > 0:
            return modelo[it][1]
        return None

    def _selecionar_pid(self, pid):
        def procurar(modelo, path, it):
            if modelo[it][1] == pid:
                self.tv_proc.get_selection().select_path(path)
                return True
            return False
        self.ord_proc.foreach(procurar)

    def _proc_sel(self, *_):
        self.b_finalizar.set_sensitive(self._pid_selecionado() is not None)

    def _proc_clique(self, tv, ev):
        if ev.type != Gdk.EventType.BUTTON_PRESS or ev.button != 3:
            return False
        hit = tv.get_path_at_pos(int(ev.x), int(ev.y))
        if not hit:
            return False
        tv.get_selection().select_path(hit[0])
        pid = self._pid_selecionado()
        if not pid:
            return True
        self._menu_pid(pid, ev)
        return True

    def _menu_pid(self, pid, ev):
        menu = Gtk.Menu()
        for rotulo, func in (("Finalizar tarefa", lambda: self.finalizar(pid)),
                             ("Finalizar árvore de processos", lambda: self.finalizar(pid, arvore=True)),
                             (None, None),
                             ("Abrir local do arquivo", lambda: self.abrir_local(pid)),
                             ("Copiar linha de comando", lambda: self.copiar_cmd(pid)),
                             ("Ir para detalhes", lambda: self.ir_detalhes(pid))):
            if rotulo is None:
                menu.append(Gtk.SeparatorMenuItem())
                continue
            mi = Gtk.MenuItem(label=rotulo)
            mi.connect("activate", lambda *_, f=func: f())
            menu.append(mi)
        prio = Gtk.MenuItem(label="Definir prioridade")
        sub = Gtk.Menu()
        for rotulo, valor in (("Alta", -5), ("Acima do normal", -2), ("Normal", 0), ("Abaixo do normal", 5), ("Baixa", 15)):
            mi = Gtk.MenuItem(label=rotulo)
            mi.connect("activate", lambda *_, v=valor: self.prioridade(pid, v))
            sub.append(mi)
        prio.set_submenu(sub)
        menu.append(prio)
        menu.show_all()
        menu.attach_to_widget(self, None)
