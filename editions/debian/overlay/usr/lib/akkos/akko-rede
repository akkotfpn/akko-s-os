def ssid_texto(ap):
    ssid = ap.get_ssid()
    if ssid is None:
        return None
    return NM.utils_ssid_to_utf8(ssid.get_data())


# Enums do libnm que começam com dígito ganham "_" no PyGObject
SEC = getattr(NM, "_80211ApSecurityFlags", None) or getattr(NM, "80211ApSecurityFlags")
APF = getattr(NM, "_80211ApFlags", None) or getattr(NM, "80211ApFlags")


def seguranca(ap):
    """'aberta' | 'wpa-psk' | 'sae' | 'enterprise' | 'wep'"""
    flags, wpa, rsn = int(ap.get_flags()), int(ap.get_wpa_flags()), int(ap.get_rsn_flags())
    if (wpa | rsn) & int(SEC.KEY_MGMT_802_1X):
        return "enterprise"
    if rsn & int(SEC.KEY_MGMT_SAE) and not rsn & int(SEC.KEY_MGMT_PSK):
        return "sae"
    if (wpa | rsn) & int(SEC.KEY_MGMT_PSK):
        return "wpa-psk"
    if flags & int(APF.PRIVACY):
        return "wep"
    return "aberta"


def icone_sinal(forca):
    nivel = "excellent" if forca > 75 else "good" if forca > 50 else "ok" if forca > 25 else "weak"
    return f"network-wireless-signal-{nivel}-symbolic"


