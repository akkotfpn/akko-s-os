#!/bin/sh
# Roda quando o Openbox está pronto: papel de parede, serviços da sessão e painel.

PAPEL=/usr/share/backgrounds/akkos/akkos-wallpaper-dark.png
[ -f "$HOME/.config/akkos/papel-de-parede" ] && PAPEL="$(cat "$HOME/.config/akkos/papel-de-parede")"
feh --no-fehbg --bg-fill "$PAPEL" &

/usr/lib/akkos/akko-soundd &                 # sons do sistema (toca o boot_chime)
dunst &                                      # notificações (com som, ver dunstrc)
lxpolkit &                                   # pede senha quando algo precisa de administrador
akko-painel &                                # barra de tarefas
akko-desktop &                               # área de trabalho com ícones (desenha o papel de parede)
xcape -e 'Super_L=Super_L|space' &           # tocar a tecla Super sozinha abre o menu

# boot pela opção "Instalar o Akko's OS": abre o instalador
grep -q 'akkos.instalar=1' /proc/cmdline && ( sleep 4; akko-instalar ) &

# prepara a compatibilidade Windows em segundo plano (só na primeira vez)
( sleep 20; win-launcher primeiro-uso ) &

# o teste automatizado do CI (só com akkos.teste=1 na linha do kernel) precisa
# saber que a sessão subiu
grep -q 'akkos.teste=1' /proc/cmdline && touch "${XDG_RUNTIME_DIR:-/tmp}/akkos-sessao-pronta"
exit 0
