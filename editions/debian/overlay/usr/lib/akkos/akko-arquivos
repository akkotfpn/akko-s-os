    def _montar_atalhos(self):
        acoes = {
            "copiar": (["<Primary>c"], lambda: self.copiar(False)),
            "recortar": (["<Primary>x"], lambda: self.copiar(True)),
            "colar": (["<Primary>v"], self.colar),
            "lixeira": (["Delete"], self.mandar_lixeira),
            "excluir": (["<Shift>Delete"], self.excluir_de_vez),
            "renomear": (["F2"], self.renomear),
            "nova-pasta": (["<Primary><Shift>n"], self.nova_pasta),
            "endereco": (["<Primary>l", "<Alt>d"], self._editar_endereco),
            "voltar": (["<Alt>Left"], self.voltar),
            "avancar": (["<Alt>Right"], self.avancar),
            "subir": (["<Alt>Up"], self.subir),
            "ocultos": (["<Primary>h"], self.alternar_ocultos),
            "grandes": (["<Primary>1"], lambda: self.trocar_visao("grade", TAMANHOS["grandes"])),
            "medios": (["<Primary>2"], lambda: self.trocar_visao("grade", TAMANHOS["medios"])),
            "detalhes": (["<Primary>3"], lambda: self.trocar_visao("lista")),
            "atualizar": (["F5"], self.atualizar),
            "buscar": (["<Primary>f", "<Primary>e"], lambda: self.busca.grab_focus()),
            "previa": (["F9", "<Alt>p"], self.alternar_previa),
            "selecionar-tudo": (["<Primary>a"], self.selecionar_tudo),
            "terminal": (["<Primary><Alt>t"], self.abrir_terminal),
            "nova-janela": (["<Primary>n"], lambda: self.get_application().nova_janela(self.atual)),
            "fechar": (["<Primary>w"], self.close),
            "propriedades": (["<Alt>Return"], self.propriedades),
        }
        app = self.get_application()
        for nome, (teclas, func) in acoes.items():
            acao = Gio.SimpleAction.new(nome, None)
            acao.connect("activate", lambda _a, _p, f=func: f())
            self.add_action(acao)
            app.set_accels_for_action(f"win.{nome}", teclas)
        self.connect("key-press-event", self._tecla)

    def _campo_com_foco(self):
        if self.endereco.has_focus() or self.busca.has_focus():
            return True
        foco = self.get_focus()
        return isinstance(foco, Gtk.Entry)   # inclui a edição de nome no ícone

    def _tecla(self, _w, ev):
        if self._campo_com_foco():
            # nos campos de texto, Delete/Ctrl+C/F2 etc. são do campo, não dos arquivos
            ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
            if ev.keyval in (Gdk.KEY_Delete, Gdk.KEY_BackSpace, Gdk.KEY_Home, Gdk.KEY_End) or \
                    (ctrl and ev.keyval in (Gdk.KEY_c, Gdk.KEY_x, Gdk.KEY_v, Gdk.KEY_a, Gdk.KEY_z)):
                return self.propagate_key_event(ev)
            return False
        if ev.keyval == Gdk.KEY_BackSpace:
            self.voltar() if self.historico else self.subir()
            return True
        return False

    def _tecla_endereco(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.endereco_pilha.set_visible_child_name("migalhas")
            self._vista().grab_focus()
            return True
        return False

