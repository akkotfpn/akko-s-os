    def _bloco(self, icone, titulo, sub, acao, uso=None, dica=None):
        botao = Gtk.Button(relief=Gtk.ReliefStyle.NONE)
        botao.get_style_context().add_class("bloco")
        botao.set_size_request(250, -1)
        caixa = Gtk.Box(spacing=12)
        img = Gtk.Image.new_from_gicon(icone, Gtk.IconSize.DIALOG) if isinstance(icone, Gio.Icon) \
            else Gtk.Image.new_from_icon_name(icone, Gtk.IconSize.DIALOG)
        img.set_pixel_size(48)
        caixa.pack_start(img, False, False, 0)
        textos = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3, valign=Gtk.Align.CENTER)
        textos.pack_start(Gtk.Label(label=titulo, xalign=0, ellipsize=Pango.EllipsizeMode.END), False, False, 0)
        if uso is not None:
            barra = Gtk.LevelBar(min_value=0, max_value=1, value=uso)
            barra.remove_offset_value("low")
            barra.remove_offset_value("high")
            barra.remove_offset_value("full")
            if uso > 0.9:
                barra.get_style_context().add_class("cheio")
            barra.set_size_request(160, 8)
            textos.pack_start(barra, False, False, 0)
        if sub:
            s = Gtk.Label(label=sub, xalign=0)
            s.get_style_context().add_class("akkos-muted")
            textos.pack_start(s, False, False, 0)
        caixa.pack_start(textos, True, True, 0)
        botao.add(caixa)
        if dica:
            botao.set_tooltip_text(dica)
        botao.connect("clicked", lambda *_: (ak.tocar("click"), acao()))
        return botao

    def _montar_computador(self):
        for f in self.pc.get_children():
            self.pc.remove(f)

        def secao(titulo):
            r = Gtk.Label(label=titulo, xalign=0)
            r.get_style_context().add_class("secao")
            self.pc.pack_start(r, False, False, 0)
            fb = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True, max_children_per_line=6,
                             column_spacing=10, row_spacing=10, margin_start=18, margin_end=18)
            self.pc.pack_start(fb, False, False, 0)
            return fb

        fb = secao("Pastas")
        for icone, rotulo, caminho in pastas_pessoais():
            fb.add(self._bloco(icone, rotulo, "", lambda c=caminho: self.navegar(c), dica=caminho))
        fb = secao("Dispositivos e unidades")
        for d in self.drives:
            titulo = f"{d['nome']} ({d['letra']}:)"
            if d["caminho"] and d["total"]:
                uso = 1 - d["livre"] / d["total"]
                sub = f"{ak.formatar_tamanho(d['livre'])} livres de {ak.formatar_tamanho(d['total'])}"
                fb.add(self._bloco(d["icone"], titulo, sub, lambda c=d["caminho"]: self.navegar(c), uso, d["caminho"]))
            else:
                fb.add(self._bloco(d["icone"], titulo, "Clique para abrir",
                                   lambda v=d["volume"]: v and self._montar_volume(v, abrir=True)))
        prefixos = os.path.join(GLib.get_user_data_dir(), "akkos", "wine", "prefixos")
        if os.path.isdir(prefixos):
            fb = secao("Programas Windows")
            for nome in sorted(os.listdir(prefixos)):
                dc = os.path.join(prefixos, nome, "drive_c")
                if os.path.isdir(dc):
                    fb.add(self._bloco("wine", f"C: do Windows ({nome})", "Programas instalados com o Wine",
                                       lambda c=dc: self.navegar(c), dica=dc))
        self.pc.show_all()

    # ---------------------------------------------------------------- navegação

    def _rotulo_local(self, caminho):
        if caminho == COMPUTADOR:
            return "Este Computador"
        if caminho.startswith("trash:"):
            return "Lixeira"
        if caminho == GLib.get_home_dir():
            return os.path.basename(caminho)
        for icone, rotulo, c in pastas_pessoais():
            if c == caminho:
                return rotulo
        if caminho == "/":
            return "Disco Local (C:)"
        return os.path.basename(caminho) or caminho

    def navegar(self, alvo, registrar=True):
        if alvo in (COMPUTADOR, "computador:", "Este Computador"):
            caminho = COMPUTADOR
        elif alvo.startswith("trash:"):
            caminho = LIXEIRA
        else:
            caminho = os.path.abspath(os.path.expanduser(alvo))
            if not os.path.isdir(caminho):
                self.avisar(f"Não foi possível encontrar “{alvo}”.", erro=True)
                return
            if not os.access(caminho, os.R_OK | os.X_OK):
                self.avisar(f"Você não tem permissão para abrir “{caminho}”.", erro=True)
                return
        if registrar and self.atual and self.atual != caminho:
            self.historico.append(self.atual)
            self.futuro.clear()
        self.atual = caminho
        self.busca_resultados = None
        self.col_local.set_visible(False)
        self.busca.set_text("")
        self.busca.set_placeholder_text(f"Pesquisar em {self._rotulo_local(caminho)}")
        self.set_title(self._rotulo_local(caminho))
        self._atualizar_migalhas()
        self.endereco_pilha.set_visible_child_name("migalhas")
        if caminho == COMPUTADOR:
            self.drives = unidades(self.volumes)
            self._montar_computador()
            self.pilha.set_visible_child_name("computador")
            self.modelo.clear()
            self._atualizar_status()
            self._mostrar_previa(None)
        else:
            self.pilha.set_visible_child_name(self._visao_pref)
            self.carregar()
        self.b_voltar.set_sensitive(bool(self.historico))
        self.b_avancar.set_sensitive(bool(self.futuro))
        self.b_subir.set_sensitive(caminho not in (COMPUTADOR,))
        self._atualizar_botoes()
        self._vigiar_pasta()
        self._marcar_lateral()

    def _marcar_lateral(self):
        self.lateral.unselect_all()
        for linha in self.lateral.get_children():
            if getattr(linha, "alvo", None) == self.atual:
                self.lateral.select_row(linha)
                break

    def _atualizar_migalhas(self):
        for f in self.migalhas.get_children():
            self.migalhas.remove(f)
        partes = []   # (rótulo, alvo)
        if self.atual == COMPUTADOR:
            partes = [("Este Computador", COMPUTADOR)]
        elif self.atual.startswith("trash:"):
            partes = [("Lixeira", LIXEIRA)]
        else:
            casa = GLib.get_home_dir()
            if self.atual == casa or self.atual.startswith(casa + "/"):
                partes = [(os.path.basename(casa), casa)]
                atual = casa
                for p in self.atual[len(casa):].strip("/").split("/"):
                    if p:
                        atual = os.path.join(atual, p)
                        partes.append((p, atual))
            else:
                drive = None
                for d in self.drives:
                    c = d["caminho"]
                    if c and (self.atual == c or self.atual.startswith(c.rstrip("/") + "/")):
                        if drive is None or len(c) > len(drive["caminho"]):
                            drive = d
                partes = [("Este Computador", COMPUTADOR)]
                if drive:
                    partes.append((f"{drive['nome']} ({drive['letra']}:)", drive["caminho"]))
                    atual = drive["caminho"]
                    resto = self.atual[len(drive["caminho"].rstrip("/")):].strip("/")
                else:
                    atual, resto = "/", self.atual.strip("/")
                for p in resto.split("/"):
                    if p:
                        atual = os.path.join(atual, p)
                        partes.append((ALIAS_DISPLAY.get(atual, p), atual))
        icone = Gtk.Image.new_from_icon_name("computer-symbolic" if self.atual == COMPUTADOR else
                                             "user-trash-symbolic" if self.atual.startswith("trash:")
                                             else "folder-symbolic", Gtk.IconSize.MENU)
        icone.set_margin_start(8)
        icone.set_margin_end(4)
        self.migalhas.pack_start(icone, False, False, 0)
        for i, (rotulo, alvo) in enumerate(partes):
            if i:
                s = Gtk.Label(label="›")
                s.get_style_context().add_class("sep")
                self.migalhas.pack_start(s, False, False, 2)
            b = Gtk.Button(label=rotulo, relief=Gtk.ReliefStyle.NONE)
            b.connect("clicked", lambda *_, a=alvo: self.navegar(a))
            self.migalhas.pack_start(b, False, False, 0)
        self.migalhas.show_all()

    def _editar_endereco(self):
        if self.atual == COMPUTADOR:
            texto = "Este Computador"
        elif self.atual.startswith("trash:"):
            texto = "Lixeira"
        else:
            texto = para_windows(self.atual, self.drives)
        self.endereco.set_text(texto)
        self.endereco_pilha.set_visible_child_name("texto")
        self.endereco.grab_focus()
        self.endereco.select_region(0, -1)

    def _ir_endereco(self, entrada):
        texto = entrada.get_text().strip().strip('"')
        if not texto:
            return
        baixo = texto.casefold()
        if baixo in ("lixeira", "trash:", "trash:///", "shell:recyclebinfolder"):
            self.navegar(LIXEIRA)
        elif baixo in ("este computador", "computador", "meu computador", "computador://", "this pc"):
            self.navegar(COMPUTADOR)
        else:
            if texto.startswith("file://"):
                caminho = unquote(urlparse(texto).path)
            else:
                caminho = de_windows(texto, self.drives) or os.path.expanduser(texto)
            if os.path.isfile(caminho):
                self.navegar(os.path.dirname(caminho))
                self.abrir(caminho)
            else:
                self.navegar(caminho)
        self._vista().grab_focus()

    def voltar(self):
        if self.historico:
            self.futuro.append(self.atual)
            self.navegar(self.historico.pop(), registrar=False)

    def avancar(self):
        if self.futuro:
            self.historico.append(self.atual)
            self.navegar(self.futuro.pop(), registrar=False)

    def subir(self):
        if not self.atual or self.atual == COMPUTADOR:
            return
        if self.atual.startswith("trash:") or self.atual == "/":
            self.navegar(COMPUTADOR)
            return
        for d in self.drives:
            if d["caminho"] == self.atual:
                self.navegar(COMPUTADOR)
                return
        self.navegar(os.path.dirname(self.atual))

    def atualizar(self):
        if self.atual:
            self.drives = unidades(self.volumes)
            self.navegar(self.atual, registrar=False)

    def _vigiar_pasta(self):
        if self.monitor_pasta:
            self.monitor_pasta.cancel()
            self.monitor_pasta = None
        if self.atual == COMPUTADOR:
            return
        gfile = Gio.File.new_for_uri(self.atual) if self.atual.startswith("trash:") else Gio.File.new_for_path(self.atual)
        try:
            self.monitor_pasta = gfile.monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
            self.monitor_pasta.set_rate_limit(500)
            self.monitor_pasta.connect("changed", self._pasta_mudou)
        except GLib.Error:
            self.monitor_pasta = None

    def _pasta_mudou(self, *_):
        if self.busca_resultados is not None or self._editando():
            return
        if not hasattr(self, "_recarga_pendente"):
            self._recarga_pendente = GLib.timeout_add(300, self._recarregar_preservando)

    def _recarregar_preservando(self):
        del self._recarga_pendente
        if self._editando():
            return False
        sel = set(self.selecionados())
        self.carregar()
        self._selecionar(sel)
        return False

    def _editando(self):
        return self.r_nome_grade.get_property("editable") or self.r_nome_lista.get_property("editable")

    # ---------------------------------------------------------------- listagem

    def _icone_para(self, info, tamanho=None):
        tamanho = tamanho or (self.tamanho_icone if self._visao_pref == "grade" else 24)
        tema = Gtk.IconTheme.get_default()
        gicon = info.get_icon()
        if gicon:
            achado = tema.lookup_by_gicon(gicon, tamanho, Gtk.IconLookupFlags.FORCE_SIZE)
            if achado:
                try:
                    return achado.load_icon()
                except GLib.Error:
                    pass
        return tema.load_icon("text-x-generic", tamanho, Gtk.IconLookupFlags.FORCE_SIZE)

    def _linha(self, gfile, info, caminho):
        nome = info.get_display_name()
        eh_pasta = info.get_file_type() == Gio.FileType.DIRECTORY
        tamanho = info.get_size()
        mod = info.get_modification_date_time()
        ts = mod.to_unix() if mod else 0
        ctype = info.get_content_type() or "application/octet-stream"
        tipo = "Pasta de arquivos" if eh_pasta else Gio.content_type_get_description(ctype)
        if nome.lower().endswith(EXT_WINDOWS):
            tipo = "Programa Windows"
        elif nome.lower().endswith(".appimage"):
            tipo = "Aplicativo (AppImage)"
        local = os.path.dirname(caminho) if not caminho.startswith("trash:") else \
            os.path.dirname(info.get_attribute_byte_string("trash::orig-path") or "")
        return [self._icone_para(info), nome, caminho, eh_pasta, tamanho,
                "" if eh_pasta else ak.formatar_tamanho(tamanho), tipo, ts,
                data_txt(ts) if ts else "", info.get_is_hidden() or nome.startswith("."),
                para_windows(local, self.drives) if local else ""]

    def carregar(self):
        self.modelo.clear()
        fila = []
        if self.busca_resultados is not None:
            fontes = [(Gio.File.new_for_path(c), c) for c in self.busca_resultados]
            atributos = "standard::*,time::modified"
            for gf, c in fontes:
                try:
                    info = gf.query_info(atributos, Gio.FileQueryInfoFlags.NONE, None)
                except GLib.Error:
                    continue
                self.modelo.append(self._linha(gf, info, c))
            self._atualizar_status()
            return
        gpasta = Gio.File.new_for_uri(self.atual) if self.atual.startswith("trash:") else Gio.File.new_for_path(self.atual)
        try:
            enum = gpasta.enumerate_children("standard::*,time::modified,trash::orig-path",
                                             Gio.FileQueryInfoFlags.NONE, None)
        except GLib.Error as erro:
            self.avisar(f"Não foi possível listar a pasta: {erro.message}", erro=True)
            return
        for info in enum:
            if self.atual.startswith("trash:"):
                caminho = enum.get_child(info).get_uri()
            else:
                caminho = os.path.join(self.atual, info.get_name())
            it = self.modelo.append(self._linha(gpasta, info, caminho))
            ctype = info.get_content_type() or ""
            if ctype.startswith("image/") and info.get_size() < LIMITE_MINIATURA and not caminho.startswith("trash:"):
                fila.append((Gtk.TreeRowReference.new(self.modelo, self.modelo.get_path(it)), caminho))
        self._atualizar_status()
        self._mostrar_previa(None)
        if fila and self._visao_pref == "grade":
            threading.Thread(target=self._gerar_miniaturas, args=(fila, self.atual, self.tamanho_icone),
                             daemon=True).start()
        if self._renomear_apos_carga:
            alvo, self._renomear_apos_carga = self._renomear_apos_carga, None
            GLib.idle_add(self._iniciar_edicao, alvo)

    def _gerar_miniaturas(self, fila, pasta, tamanho):
        for ref, caminho in fila:
            if pasta != self.atual:
                return
            try:
                pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(caminho, tamanho, tamanho, True)
            except GLib.Error:
                continue
            GLib.idle_add(self._aplicar_miniatura, ref, pix, pasta)

    def _aplicar_miniatura(self, ref, pix, pasta):
        if pasta == self.atual and ref.valid():
            self.modelo.set_value(self.modelo.get_iter(ref.get_path()), C_ICONE, pix)
        return False

    def _visivel(self, modelo, it, *_):
        if modelo[it][C_OCULTO] and not self.mostrar_ocultos:
            return False
        if self.busca_resultados is not None:
            return True
        termo = self.busca.get_text().strip().casefold()
        return not termo or termo in modelo[it][C_NOME].casefold()

    def _comparar(self, modelo, a, b, coluna):
        pa, pb = modelo[a][C_EH_PASTA], modelo[b][C_EH_PASTA]
        _col, ordem = self.ordenado.get_sort_column_id()
        if pa != pb:
            # pastas sempre primeiro, mesmo na ordem decrescente
            r = -1 if pa else 1
            return r if ordem != Gtk.SortType.DESCENDING else -r
        va, vb = modelo[a][coluna], modelo[b][coluna]
        if isinstance(va, str):
            va, vb = va.casefold(), vb.casefold()
        if va == vb and coluna != C_NOME:
            va, vb = modelo[a][C_NOME].casefold(), modelo[b][C_NOME].casefold()
        return (va > vb) - (va < vb)

    def classificar(self, coluna=None, ordem=None):
        col_atual, ordem_atual = self.ordenado.get_sort_column_id()
        if col_atual is None or col_atual < 0:
            col_atual, ordem_atual = C_NOME, Gtk.SortType.ASCENDING
        self.ordenado.set_sort_column_id(coluna if coluna is not None else col_atual,
                                         ordem if ordem is not None else ordem_atual)

    def alternar_ocultos(self):
        self.mostrar_ocultos = not self.mostrar_ocultos
        self.filtro.refilter()
        self._atualizar_status()
        self._salvar_prefs()
        self.avisar("Itens ocultos visíveis." if self.mostrar_ocultos else "Itens ocultos escondidos.")

    def alternar_previa(self):
        self.previa_revelar.set_reveal_child(not self.previa_revelar.get_reveal_child())
        self._selecao_mudou()
        self._salvar_prefs()

    def trocar_visao(self, nome, tamanho=None):
        sel = set(self.selecionados())
        mudou_tamanho = tamanho and tamanho != self.tamanho_icone
        mudou_tipo = nome != self._visao_pref
        self._visao_pref = nome
        if tamanho:
            self.tamanho_icone = tamanho
            self.grade.set_item_width(tamanho + 48)
        self._salvar_prefs()
        if self.atual == COMPUTADOR:
            return
        self.pilha.set_visible_child_name(nome)
        if mudou_tamanho or mudou_tipo:
            self.carregar()
        self._selecionar(sel)

    def _busca_mudou(self, *_):
        if self.busca_resultados is not None and not self.busca.get_text().strip():
            self.busca_resultados = None
            self.col_local.set_visible(False)
            self.carregar()
        self.filtro.refilter()
        self._atualizar_status()

    def buscar_recursivo(self):
        termo = self.busca.get_text().strip().casefold()
        if not termo or not self.atual or self.atual.startswith("trash:"):
            return
        base = GLib.get_home_dir() if self.atual == COMPUTADOR else self.atual
        self.status.set_text(f"Pesquisando “{termo}” em {self._rotulo_local(base)}…")

        def trabalho():
            achados = []
            for raiz, dirs, arqs in os.walk(base):
                dirs[:] = [d for d in dirs if self.mostrar_ocultos or not d.startswith(".")]
                if raiz.startswith(("/proc", "/sys", "/dev", "/run")):
                    dirs[:] = []
                    continue
                for n in dirs + arqs:
                    if termo in n.casefold():
                        achados.append(os.path.join(raiz, n))
                if len(achados) >= 2000:
                    break
            GLib.idle_add(mostrar, achados)

        def mostrar(achados):
            self.busca_resultados = achados
            self.pilha.set_visible_child_name(self._visao_pref)
            self.col_local.set_visible(True)
            self.carregar()
            self.avisar(f"{len(achados)} resultado(s) para “{termo}”{' (limite de 2000)' if len(achados) >= 2000 else ''}."
                        " Apague a pesquisa para voltar à pasta.")
            return False

        threading.Thread(target=trabalho, daemon=True).start()

    # ---------------------------------------------------------------- seleção

    def _vista(self):
        return self.grade if self.pilha.get_visible_child_name() == "grade" else self.lista

    def _caminho_de(self, tree_path):
        return self.ordenado[tree_path][C_CAMINHO]

    def selecionados_em(self, vista):
        if vista is self.grade:
            caminhos = self.grade.get_selected_items()
        else:
            _, caminhos = self.lista.get_selection().get_selected_rows()
        return [self.ordenado[p][C_CAMINHO] for p in caminhos]

    def selecionados(self):
        if self.atual == COMPUTADOR:
            return []
        return self.selecionados_em(self._vista())

    def _selecionar(self, conjunto):
        primeiro = None
        for linha in self.ordenado:
            if linha[C_CAMINHO] in conjunto:
                if self._vista() is self.grade:
                    self.grade.select_path(linha.path)
                else:
                    self.lista.get_selection().select_path(linha.path)
                primeiro = primeiro or linha.path
        if primeiro is not None:
            if self._vista() is self.grade:
                self.grade.scroll_to_path(primeiro, False, 0, 0)
            else:
                self.lista.scroll_to_cell(primeiro, None, False, 0, 0)

    def selecionar_tudo(self):
        if self._campo_com_foco():
            return
        (self.grade.select_all if self._vista() is self.grade else self.lista.get_selection().select_all)()

    def _selecao_mudou(self):
        sel = self.selecionados()
        if self.previa_revelar.get_reveal_child():
            self._mostrar_previa(sel[0] if len(sel) == 1 else None, len(sel))
        self._atualizar_status()
        self._atualizar_botoes()

    def _atualizar_botoes(self):
        sel = self.selecionados()
        normal = bool(self.atual) and self.atual not in (COMPUTADOR,) and not self.atual.startswith("trash:")
        for b in (self.b_recortar, self.b_copiar):
            b.set_sensitive(bool(sel) and normal)
        self.b_renomear.set_sensitive(len(sel) == 1 and normal)
        self.b_excluir.set_sensitive(bool(sel))
        self.b_colar.set_sensitive(normal and bool(self.area_transf[0]))
        self.b_novo.set_sensitive(normal)

    def _atualizar_status(self):
        if self.atual == COMPUTADOR:
            self.status.set_text(f"{len(self.drives)} unidade(s)")
            return
        visiveis = len(self.ordenado)
        texto = f"{visiveis} {'item' if visiveis == 1 else 'itens'}"
        sel = self.selecionados()
        if sel:
            soma = 0
            for c in sel:
                try:
                    if not c.startswith("trash:") and os.path.isfile(c):
                        soma += os.path.getsize(c)
                except OSError:
                    pass
            texto += f"     {len(sel)} {'item selecionado' if len(sel) == 1 else 'itens selecionados'}"
            if soma:
                texto += f"  {ak.formatar_tamanho(soma)}"
        if self.atual and not self.atual.startswith("trash:"):
            try:
                st = os.statvfs(self.atual)
                texto += f"     {ak.formatar_tamanho(st.f_bavail * st.f_frsize)} livres"
            except OSError:
                pass
        self.status.set_text(texto)

    # ---------------------------------------------------------------- visualização

    def _mostrar_previa(self, caminho, quantidade=0):
        for filho in self.previa.get_children():
            self.previa.remove(filho)
        if caminho is None:
            msg = f"{quantidade} itens selecionados" if quantidade > 1 else "Selecione um arquivo para visualizar"
            r = Gtk.Label(label=msg, wrap=True)
            r.get_style_context().add_class("akkos-muted")
            self.previa.pack_start(r, False, False, 20)
            self.previa.show_all()
            return
        gfile = Gio.File.new_for_uri(caminho) if caminho.startswith("trash:") else Gio.File.new_for_path(caminho)
        try:
            info = gfile.query_info("standard::*,time::modified", Gio.FileQueryInfoFlags.NONE, None)
        except GLib.Error as erro:
            self.previa.pack_start(Gtk.Label(label=erro.message, wrap=True), False, False, 0)
            self.previa.show_all()
            return
        ctype = info.get_content_type() or ""
        nome = info.get_display_name()
        local = gfile.get_path()
        visual = None
        if local and ctype.startswith("image/") and info.get_size() < LIMITE_MINIATURA:
            try:
                visual = Gtk.Image.new_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_scale(local, 276, 276, True))
            except GLib.Error:
                visual = None
        if visual is None and local and (ctype.startswith("text/") or nome.lower().endswith(EXT_TEXTO)) \
                and info.get_size() < 2 * 1024 * 1024:
            try:
                with open(local, "r", errors="replace") as f:
                    trecho = "".join(f.readline() for _ in range(60))
                tv = Gtk.TextView(editable=False, cursor_visible=False, monospace=True, wrap_mode=Gtk.WrapMode.CHAR)
                tv.get_buffer().set_text(trecho)
                tv.set_size_request(276, 260)
                visual = tv
            except OSError:
                visual = None
        if visual is None:
            visual = Gtk.Image.new_from_gicon(info.get_icon() or Gio.ThemedIcon.new("text-x-generic"), Gtk.IconSize.DIALOG)
            visual.set_pixel_size(128)
        self.previa.pack_start(visual, False, False, 0)
        titulo = Gtk.Label(label=nome, wrap=True, xalign=0)
        titulo.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        titulo.get_style_context().add_class("akkos-titulo")
        self.previa.pack_start(titulo, False, False, 0)
        detalhes = [("Tipo", "Pasta de arquivos" if info.get_file_type() == Gio.FileType.DIRECTORY
                     else Gio.content_type_get_description(ctype))]
        if info.get_file_type() != Gio.FileType.DIRECTORY:
            detalhes.append(("Tamanho", ak.formatar_tamanho(info.get_size())))
        mod = info.get_modification_date_time()
        if mod:
            detalhes.append(("Modificado", data_txt(mod.to_unix())))
        grade = Gtk.Grid(column_spacing=10, row_spacing=4)
        for i, (k, v) in enumerate(detalhes):
            rk = Gtk.Label(label=k, xalign=1, yalign=0)
            rk.get_style_context().add_class("akkos-muted")
            rv = Gtk.Label(label=v, xalign=0, wrap=True, selectable=True)
            grade.attach(rk, 0, i, 1, 1)
            grade.attach(rv, 1, i, 1, 1)
        self.previa.pack_start(grade, False, False, 0)
        self.previa.show_all()

    # ---------------------------------------------------------------- abrir

    def _confirmar(self, titulo, texto, botao="Continuar", perigoso=False):
        d = Gtk.MessageDialog(transient_for=self, modal=True,
                              message_type=Gtk.MessageType.WARNING if perigoso else Gtk.MessageType.QUESTION,
                              buttons=Gtk.ButtonsType.NONE, text=titulo)
        d.format_secondary_text(texto)
        d.add_button("Cancelar", Gtk.ResponseType.CANCEL)
        ok = d.add_button(botao, Gtk.ResponseType.OK)
        ok.get_style_context().add_class("destructive-action" if perigoso else "suggested-action")
        d.set_default_response(Gtk.ResponseType.CANCEL if perigoso else Gtk.ResponseType.OK)
        resp = d.run()
        d.destroy()
        return resp == Gtk.ResponseType.OK

    def abrir(self, caminho):
        if caminho.startswith("trash:"):
            gfile = Gio.File.new_for_uri(caminho)
            info = gfile.query_info("standard::type", Gio.FileQueryInfoFlags.NONE, None)
            if info.get_file_type() == Gio.FileType.DIRECTORY:
                self.navegar(caminho)
            else:
                self.avisar("Restaure o arquivo (botão direito → Restaurar) para abri-lo.")
            return
        if os.path.isdir(caminho):
            ak.tocar("click")
            self.navegar(caminho)
            return
        nome = os.path.basename(caminho).lower()
        if nome.endswith(".desktop") and os.path.isfile(caminho):
            app = Gio.DesktopAppInfo.new_from_filename(caminho)
            if app:
                try:
                    app.launch([], Gdk.Display.get_default().get_app_launch_context())
                    return
                except GLib.Error as erro:
                    self.avisar(erro.message, erro=True)
                    return
        if nome.endswith(EXT_WINDOWS):
            ak.executar_destacado(["win-launcher", caminho], cwd=os.path.dirname(caminho))
            return
        if nome.endswith(".appimage"):
            if self._confirmar("Executar este aplicativo?",
                               f"“{os.path.basename(caminho)}” é um programa (AppImage). Só execute "
                               "programas de fontes em que você confia.", "Executar"):
                try:
                    os.chmod(caminho, os.stat(caminho).st_mode | stat.S_IXUSR)
                    ak.executar_destacado([caminho], cwd=os.path.dirname(caminho))
                except OSError as erro:
                    self.avisar(f"Não foi possível executar: {erro.strerror}", erro=True)
            return
        if nome.endswith(".deb"):
            if self._confirmar("Instalar pacote do sistema?",
                               f"“{os.path.basename(caminho)}” será instalado com o apt, como administrador. "
                               "Pacotes .deb têm acesso total ao sistema: instale só de fontes confiáveis.",
                               "Instalar", perigoso=True):
                ak.executar_destacado(["xfce4-terminal", "--hold", "-T", "Instalando pacote", "-x",
                                       "sudo", "apt-get", "install", "-y", os.path.abspath(caminho)])
            return
        if nome.endswith(".flatpakref"):
            if self._confirmar("Instalar aplicativo Flatpak?", os.path.basename(caminho), "Instalar"):
                ak.executar_destacado(["xfce4-terminal", "--hold", "-T", "Instalando aplicativo",
                                       "-x", "flatpak", "install", "--user", "-y", "--from", caminho])
            return
        if eh_elf(caminho):
            if not os.access(caminho, os.X_OK):
                if not self._confirmar("Marcar como executável?",
                                       "Este arquivo é um programa Linux sem permissão de execução. "
                                       "Só faça isso se confiar na origem.", "Marcar e executar"):
                    return
                try:
                    os.chmod(caminho, os.stat(caminho).st_mode | stat.S_IXUSR)
                except OSError as erro:
                    self.avisar(f"Não foi possível alterar a permissão: {erro.strerror}", erro=True)
                    return
            elif not self._confirmar("Executar este programa?", os.path.basename(caminho), "Executar"):
                return
            ak.executar_destacado([caminho], cwd=os.path.dirname(caminho))
            return
        try:
            Gio.AppInfo.launch_default_for_uri(Gio.File.new_for_path(caminho).get_uri(),
                                               Gdk.Display.get_default().get_app_launch_context())
        except GLib.Error:
            self._abrir_com(caminho)

    def _abrir_com(self, caminho):
        gfile = Gio.File.new_for_path(caminho)
        d = Gtk.AppChooserDialog.new(self, Gtk.DialogFlags.MODAL, gfile)
        if d.run() == Gtk.ResponseType.OK and d.get_app_info():
            try:
                d.get_app_info().launch([gfile], None)
            except GLib.Error as erro:
                self.avisar(erro.message, erro=True)
        d.destroy()

    # ---------------------------------------------------------------- criar / renomear

    def _pasta_gravavel(self):
        if not self.atual or self.atual == COMPUTADOR or self.atual.startswith("trash:") or \
                self.busca_resultados is not None:
            self.avisar("Abra uma pasta para criar itens nela.", erro=True)
            return False
        if not os.access(self.atual, os.W_OK):
            self.avisar("Você não tem permissão para criar itens nesta pasta.", erro=True)
            return False
        return True

    def nova_pasta(self):
        if not self._pasta_gravavel():
            return
        caminho = nome_unico(self.atual, "Nova pasta", sufixo_copia=False)
        try:
            os.mkdir(caminho)
        except OSError as erro:
            self.avisar(f"Não foi possível criar a pasta: {erro.strerror}", erro=True)
            return
        ak.tocar("click")
        self._renomear_apos_carga = caminho
        self.carregar()

    def novo_arquivo(self, nome):
        if not self._pasta_gravavel():
            return
        caminho = nome_unico(self.atual, nome, sufixo_copia=False)
        try:
            with open(caminho, "x"):
                pass
        except OSError as erro:
            self.avisar(f"Não foi possível criar o arquivo: {erro.strerror}", erro=True)
            return
        ak.tocar("click")
        self._renomear_apos_carga = caminho
        self.carregar()

    def _iniciar_edicao(self, caminho):
        for linha in self.ordenado:
            if linha[C_CAMINHO] == caminho:
                path = linha.path
                if self._vista() is self.grade:
                    self.grade.unselect_all()
                    self.grade.select_path(path)
                    self.grade.scroll_to_path(path, False, 0, 0)
                    self.r_nome_grade.set_property("editable", True)
                    self.grade.set_cursor(path, self.r_nome_grade, True)
                else:
                    self.lista.get_selection().unselect_all()
                    self.r_nome_lista.set_property("editable", True)
                    self.lista.set_cursor_on_cell(path, self.col_nome, self.r_nome_lista, True)
                break
        return False

    def _edicao_comecou(self, _r, editavel, _path):
        if isinstance(editavel, Gtk.Entry):
            def selecionar():
                texto = editavel.get_text()
                base, ext = os.path.splitext(texto)
                eh_pasta = False
                for linha in self.ordenado:
                    if linha[C_NOME] == texto:
                        eh_pasta = linha[C_EH_PASTA]
                        break
                editavel.select_region(0, len(texto) if eh_pasta or not base else len(base))
                return False
            GLib.idle_add(selecionar)

    def renomear(self):
        sel = self.selecionados()
        if len(sel) != 1 or sel[0].startswith("trash:") or self.atual == COMPUTADOR:
            return
        self._iniciar_edicao(sel[0])

    def _nome_editado(self, renderer, path_str, novo_nome):
        renderer.set_property("editable", False)
        try:
            antigo = self.ordenado[Gtk.TreePath.new_from_string(path_str)][C_CAMINHO]
        except (ValueError, IndexError):
            return
        novo_nome = novo_nome.strip()
        if not novo_nome or novo_nome == os.path.basename(antigo):
            return
        if "/" in novo_nome or novo_nome in (".", ".."):
            self.avisar("O nome não pode conter “/”.", erro=True)
            return
        novo = os.path.join(os.path.dirname(antigo), novo_nome)
        if os.path.lexists(novo):
            self.avisar(f"Já existe um item chamado “{novo_nome}” nesta pasta.", erro=True)
            return
        try:
            os.rename(antigo, novo)
        except OSError as erro:
            self.avisar(f"Não foi possível renomear: {erro.strerror}", erro=True)
            return
        self.carregar()
        self._selecionar({novo})
        self._vista().grab_focus()

    # ---------------------------------------------------------------- copiar / colar / excluir

    def copiar(self, recortar):
        sel = [s for s in self.selecionados() if not s.startswith("trash:")]
        if not sel:
            return
        self.area_transf = (sel, recortar)
        Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text("\n".join(sel), -1)
        n = len(sel)
        self.avisar(f"{n} {'item' if n == 1 else 'itens'} {'recortado' if recortar else 'copiado'}"
                    f"{'' if n == 1 else 's'}. Use Colar (Ctrl+V) na pasta de destino.")
        ak.tocar("click")
        self._atualizar_botoes()

    def colar(self):
        origens, recortar = self.area_transf
        if not origens:
            # aceita caminhos copiados de outro lugar (ex.: área de trabalho, terminal)
            texto = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).wait_for_text() or ""
            origens = [l.strip() for l in texto.splitlines() if l.strip().startswith("/") and os.path.exists(l.strip())]
            recortar = False
        if not origens or not self._pasta_gravavel():
            return
        self._executar_operacao(origens, self.atual, recortar)
        if recortar:
            self.area_transf = ([], False)

    def _executar_operacao(self, origens, destino, mover):
        op = Operacao(self, origens, destino, mover)
        try:
            livre = os.statvfs(destino)
            if not mover and op.total > livre.f_bavail * livre.f_frsize:
                self.avisar(f"Espaço insuficiente: precisa de {ak.formatar_tamanho(op.total)}.", erro=True)
                return
        except OSError:
            pass
        self.operacoes.append(op)
        self.progresso_barra.show()
        self.progresso(op)
        threading.Thread(target=op.executar, daemon=True).start()

    def progresso(self, op):
        frac = op.feito / op.total if op.total else 1.0
        self.progresso_barra.set_fraction(min(frac, 1.0))
        verbo = "Movendo" if op.mover else "Copiando"
        self.progresso_barra.set_text(f"{verbo} {ak.formatar_tamanho(op.feito)} de {ak.formatar_tamanho(op.total)}")
        return False

    def operacao_terminou(self, op):
        self.operacoes.remove(op)
        if not self.operacoes:
            self.progresso_barra.hide()
        if op.erros:
            self.avisar("Alguns itens falharam:\n" + "\n".join(op.erros[:8]), erro=True)
        else:
            ak.tocar("notify")
        if self.atual and self.atual != COMPUTADOR:
            self.carregar()
            self._selecionar(set(op.resultado))
        self._atualizar_botoes()
        return False

    def mandar_lixeira(self):
        sel = self.selecionados()
        if not sel:
            return
        if self.atual.startswith("trash:"):
            self.excluir_de_vez()
            return
        falhas = []
        for c in sel:
            try:
                Gio.File.new_for_path(c).trash(None)
            except GLib.Error as erro:
                falhas.append((c, erro.message))
        if falhas:
            if self._confirmar("Não é possível mandar para a Lixeira",
                               f"{len(falhas)} item(ns) não podem ir para a Lixeira neste local "
                               f"({falhas[0][1]}). Excluir permanentemente?", "Excluir", perigoso=True):
                self._apagar([c for c, _ in falhas])
        else:
            ak.tocar("click")
        self.carregar()

    def excluir_de_vez(self):
        sel = self.selecionados()
        if not sel:
            return
        nomes = ", ".join(os.path.basename(unquote(s.rstrip("/"))) for s in sel[:3]) + ("…" if len(sel) > 3 else "")
        if self._confirmar(f"Excluir permanentemente {len(sel)} item(ns)?",
                           f"{nomes}\n\nEssa ação não pode ser desfeita.", "Excluir", perigoso=True):
            self._apagar(sel)
            self.carregar()

    def _apagar(self, caminhos):
        erros = []
        for c in caminhos:
            try:
                if c.startswith("trash:"):
                    Gio.File.new_for_uri(c).delete(None)
                elif os.path.isdir(c) and not os.path.islink(c):
                    shutil.rmtree(c)
                else:
                    os.remove(c)
            except (OSError, GLib.Error) as erro:
                erros.append(f"{os.path.basename(c)}: {getattr(erro, 'strerror', None) or getattr(erro, 'message', erro)}")
        if erros:
            self.avisar("Não foi possível excluir:\n" + "\n".join(erros[:8]), erro=True)
        else:
            ak.tocar("click")

    def restaurar(self):
        for c in self.selecionados():
            if not c.startswith("trash:"):
                continue
            gfile = Gio.File.new_for_uri(c)
            info = gfile.query_info("trash::orig-path", Gio.FileQueryInfoFlags.NONE, None)
            origem = info.get_attribute_byte_string("trash::orig-path")
            if not origem:
                continue
            os.makedirs(os.path.dirname(origem), exist_ok=True)
            destino = nome_unico(os.path.dirname(origem), os.path.basename(origem))
            try:
                gfile.move(Gio.File.new_for_path(destino), Gio.FileCopyFlags.NONE, None, None, None)
            except GLib.Error as erro:
                self.avisar(f"Não foi possível restaurar: {erro.message}", erro=True)
        self.carregar()

    def esvaziar_lixeira(self):
        if not self._confirmar("Esvaziar a Lixeira?", "Todos os itens serão excluídos permanentemente.",
                               "Esvaziar", perigoso=True):
            return
        lixeira = Gio.File.new_for_uri(LIXEIRA)
        for info in lixeira.enumerate_children("standard::name", Gio.FileQueryInfoFlags.NONE, None):
            try:
                lixeira.get_child(info.get_name()).delete(None)
            except GLib.Error:
                pass
        ak.tocar("notify")
        self.carregar()

    def criar_atalho_area_trabalho(self, caminhos):
        mesa = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DESKTOP) or os.path.join(GLib.get_home_dir(), "Desktop")
        os.makedirs(mesa, exist_ok=True)
        for c in caminhos:
            destino = nome_unico(mesa, os.path.basename(c) + " - Atalho", sufixo_copia=False)
            try:
                os.symlink(c, destino)
            except OSError as erro:
                self.avisar(f"Não foi possível criar o atalho: {erro.strerror}", erro=True)
                return
        self.avisar("Atalho criado na Área de Trabalho.")

    def abrir_terminal(self):
        pasta = self.atual if self.atual and not self.atual.startswith(("trash:", "computador:")) else GLib.get_home_dir()
        ak.executar_destacado(["xfce4-terminal", "--working-directory", pasta])

    # ---------------------------------------------------------------- propriedades

    def propriedades(self, caminhos=None):
        caminhos = caminhos or self.selecionados() or ([self.atual] if self.atual and
                                                       not self.atual.startswith(("trash:", "computador:")) else [])
        caminhos = [c for c in caminhos if not c.startswith("trash:")]
        if not caminhos:
            return
        d = Gtk.Dialog(title="Propriedades", transient_for=self, modal=False)
        d.get_style_context().add_class("akkos")
        d.add_button("Fechar", Gtk.ResponseType.CLOSE)
        d.connect("response", lambda dd, *_: dd.destroy())
        area = d.get_content_area()
        area.set_spacing(10)
        for lado in ("start", "end", "top", "bottom"):
            getattr(area, f"set_margin_{lado}")(16)
        um = caminhos[0]
        topo = Gtk.Box(spacing=12)
        try:
            info = Gio.File.new_for_path(um).query_info("standard::*,time::*,unix::*,owner::*",
                                                        Gio.FileQueryInfoFlags.NONE, None)
            img = Gtk.Image.new_from_gicon(info.get_icon(), Gtk.IconSize.DIALOG)
        except GLib.Error:
            info, img = None, Gtk.Image.new_from_icon_name("text-x-generic", Gtk.IconSize.DIALOG)
        img.set_pixel_size(48)
        topo.pack_start(img, False, False, 0)
        titulo = os.path.basename(um) or um if len(caminhos) == 1 else f"{len(caminhos)} itens"
        topo.pack_start(Gtk.Label(label=titulo, xalign=0, selectable=True, wrap=True), True, True, 0)
        area.pack_start(topo, False, False, 0)
        area.pack_start(Gtk.Separator(), False, False, 0)
        grade = Gtk.Grid(column_spacing=14, row_spacing=6)
        linhas = []
        if len(caminhos) == 1 and info:
            eh_pasta = info.get_file_type() == Gio.FileType.DIRECTORY
            linhas.append(("Tipo:", "Pasta de arquivos" if eh_pasta else
                           Gio.content_type_get_description(info.get_content_type() or "")))
            linhas.append(("Local:", para_windows(os.path.dirname(um), self.drives) + f"   ({os.path.dirname(um)})"))
        rotulo_tam = Gtk.Label(label="calculando…", xalign=0)
        rotulo_cont = Gtk.Label(label="", xalign=0)
        linhas.append(("Tamanho:", rotulo_tam))
        linhas.append(("Contém:", rotulo_cont))
        if len(caminhos) == 1 and info:
            mod = info.get_modification_date_time()
            criado = info.get_creation_date_time()
            if criado:
                linhas.append(("Criado em:", data_txt(criado.to_unix())))
            if mod:
                linhas.append(("Modificado em:", data_txt(mod.to_unix())))
            modo = info.get_attribute_uint32("unix::mode")
            if modo:
                linhas.append(("Permissões:", stat.filemode(modo) + ("   (executável)" if modo & 0o111 and not
                                                                       info.get_file_type() == Gio.FileType.DIRECTORY else "")))
            dono = info.get_attribute_string("owner::user")
            if dono:
                linhas.append(("Proprietário:", dono))
        for i, (k, v) in enumerate(linhas):
            rk = Gtk.Label(label=k, xalign=1)
            rk.get_style_context().add_class("akkos-muted")
            grade.attach(rk, 0, i, 1, 1)
            grade.attach(v if isinstance(v, Gtk.Widget) else Gtk.Label(label=v, xalign=0, selectable=True,
                                                                        wrap=True, max_width_chars=60), 1, i, 1, 1)
        area.pack_start(grade, False, False, 0)
        d.show_all()

        def calcular():
            tam, arqs, pastas = 0, 0, 0
            for c in caminhos:
                if os.path.isdir(c) and not os.path.islink(c):
                    for raiz, ds, fs in os.walk(c):
                        pastas += len(ds)
                        for f in fs:
                            arqs += 1
                            try:
                                tam += os.lstat(os.path.join(raiz, f)).st_size
                            except OSError:
                                pass
                else:
                    arqs += 1
                    try:
                        tam += os.lstat(c).st_size
                    except OSError:
                        pass
            GLib.idle_add(lambda: (rotulo_tam.set_text(f"{ak.formatar_tamanho(tam)} ({tam:,} bytes)".replace(",", ".")),
                                   rotulo_cont.set_text(f"{arqs} arquivo(s), {pastas} pasta(s)"), False)[-1])
        threading.Thread(target=calcular, daemon=True).start()

    # ---------------------------------------------------------------- arrastar e soltar

    def _arrastar_dados(self, vista, _ctx, dados, _info, _tempo):
        uris = [Gio.File.new_for_path(c).get_uri() for c in self.selecionados_em(vista) if not c.startswith("trash:")]
        dados.set_uris(uris)

    @staticmethod
    def _acao_soltar(origens, destino):
        teclado = Gdk.Keymap.get_for_display(Gdk.Display.get_default()).get_modifier_state()
        if teclado & Gdk.ModifierType.CONTROL_MASK:
            return False
        if teclado & Gdk.ModifierType.SHIFT_MASK:
            return True
        try:
            dev = os.stat(destino).st_dev
            return all(os.stat(o).st_dev == dev for o in origens)   # mesmo disco: move (como no Windows)
        except OSError:
            return False

    def _receber(self, uris, destino):
        origens = []
        for u in uris:
            g = Gio.File.new_for_uri(u)
            if g.get_path():
                origens.append(g.get_path())
        origens = [o for o in origens if os.path.abspath(os.path.dirname(o)) != os.path.abspath(destino)
                   or not self._acao_soltar([o], destino)]
        if not origens or not os.path.isdir(destino) or not os.access(destino, os.W_OK):
            return False
        self._executar_operacao(origens, destino, self._acao_soltar(origens, destino))
        return True

    def _soltar_na_vista(self, vista, ctx, x, y, dados, _info, tempo):
        vista.stop_emission_by_name("drag-data-received")
        destino = self.atual
        if vista is self.grade:
            ok, path, _pos = self.grade.get_dest_item_at_pos(x, y)
            if ok and path is not None and self.ordenado[path][C_EH_PASTA]:
                destino = self.ordenado[path][C_CAMINHO]
        else:
            alvo = self.lista.get_dest_row_at_pos(x, y)
            if alvo and self.ordenado[alvo[0]][C_EH_PASTA]:
                destino = self.ordenado[alvo[0]][C_CAMINHO]
        sucesso = bool(destino) and not destino.startswith(("trash:", "computador:")) and \
            self._receber(dados.get_uris() or [], destino)
        Gtk.drag_finish(ctx, sucesso, False, tempo)

    def _soltar_lateral(self, lb, ctx, _x, y, dados, _info, tempo):
        linha = lb.get_row_at_y(y)
        alvo = getattr(linha, "alvo", None) if linha else None
        sucesso = False
        if alvo == LIXEIRA:
            for u in dados.get_uris() or []:
                try:
                    Gio.File.new_for_uri(u).trash(None)
                    sucesso = True
                except GLib.Error:
                    pass
            if self.atual:
                self.carregar()
        elif isinstance(alvo, str) and not alvo.startswith("computador:"):
            sucesso = self._receber(dados.get_uris() or [], alvo)
        Gtk.drag_finish(ctx, sucesso, False, tempo)

    # ---------------------------------------------------------------- menu de contexto

    def _clique_vista(self, vista, ev):
        if ev.type != Gdk.EventType.BUTTON_PRESS:
            return False
        if ev.button in (8, 9):   # botões laterais do mouse
            self.voltar() if ev.button == 8 else self.avancar()
            return True
        if ev.button != 3:
            return False
        if vista is self.grade:
            caminho = self.grade.get_path_at_pos(int(ev.x), int(ev.y))
            if caminho and not self.grade.path_is_selected(caminho):
                self.grade.unselect_all()
                self.grade.select_path(caminho)
            elif not caminho:
                self.grade.unselect_all()
        else:
            hit = self.lista.get_path_at_pos(int(ev.x), int(ev.y))
            sel = self.lista.get_selection()
            if hit and not sel.path_is_selected(hit[0]):
                sel.unselect_all()
                sel.select_path(hit[0])
            elif not hit:
                sel.unselect_all()
        self._menu_contexto(ev)
        return True

    def _menu_contexto(self, ev):
        sel = self.selecionados()
        na_lixeira = self.atual.startswith("trash:")
        itens = []
        if sel and not na_lixeira:
            alvo = sel[0]
            nome = os.path.basename(alvo).lower()
            itens.append(("Abrir", lambda: [self.abrir(s) for s in sel[:10]]))
            if len(sel) == 1 and os.path.isdir(alvo):
                itens.append(("Abrir em nova janela", lambda: self.get_application().nova_janela(alvo)))
                if alvo not in ler_fixados():
                    itens.append(("Fixar no Acesso rápido", lambda: self.fixar(alvo)))
                else:
                    itens.append(("Desafixar do Acesso rápido", lambda: self.desafixar(alvo)))
            if len(sel) == 1 and nome.endswith(EXT_WINDOWS):
                pasta = os.path.dirname(alvo)

                def win(*opcoes):
                    ak.executar_destacado(["win-launcher", *opcoes, alvo], cwd=pasta)

                itens.append(("Abrir como aplicativo (Wine)", lambda: win("--modo", "app")))
                if not nome.endswith((".msi", ".bat", ".cmd")):
                    itens.append(("Abrir como jogo (Proton)", lambda: win("--modo", "jogo")))
                    itens.append(("Perguntar como abrir…", lambda: win("--perguntar")))
                itens.append(("Abrir sem sandbox (menos seguro)", lambda: win("--modo", "app", "--sem-sandbox")))
            if len(sel) == 1 and os.path.isfile(alvo):
                itens.append(("Abrir com…", lambda: self._abrir_com(alvo)))
            itens += [None,
                      ("Recortar", lambda: self.copiar(True)),
                      ("Copiar", lambda: self.copiar(False)),
                      ("Copiar como caminho", lambda: Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(
                          "\n".join(sel), -1)),
                      None,
                      ("Criar atalho na Área de Trabalho", lambda: self.criar_atalho_area_trabalho(sel)),
                      ("Renomear", self.renomear, len(sel) == 1),
                      ("Excluir", self.mandar_lixeira),
                      ("Excluir permanentemente…", self.excluir_de_vez),
                      None,
                      ("Propriedades", lambda: self.propriedades(sel))]
        elif sel and na_lixeira:
            itens = [("Restaurar", self.restaurar), ("Excluir permanentemente…", self.excluir_de_vez)]
        elif na_lixeira:
            itens = [("Esvaziar Lixeira…", self.esvaziar_lixeira)]
        else:
            itens = [("Exibir", self._itens_exibir()),
                     ("Classificar por", self._itens_classificar()),
                     ("Atualizar", self.atualizar),
                     None,
                     ("Colar", self.colar, bool(self.area_transf[0])),
                     ("Novo", self._itens_novo()),
                     None,
                     ("Abrir no Terminal", self.abrir_terminal),
                     ("Fixar esta pasta no Acesso rápido", lambda: self.fixar(self.atual)),
                     ("Propriedades", lambda: self.propriedades([self.atual]))]
        menu = self._menu(itens)
        menu.attach_to_widget(self, None)
        menu.popup_at_pointer(ev)

    # ---------------------------------------------------------------- avisos

    def avisar(self, texto, erro=False):
        self.info_texto.set_text(texto)
        self.info_barra.set_message_type(Gtk.MessageType.ERROR if erro else Gtk.MessageType.INFO)
        self.info_barra.set_revealed(True)
        if erro:
            ak.tocar("error")
        if hasattr(self, "_aviso_timer"):
            GLib.source_remove(self._aviso_timer)
        self._aviso_timer = GLib.timeout_add_seconds(8 if erro else 4, self._fechar_aviso)

    def _fechar_aviso(self):
        self.info_barra.set_revealed(False)
        del self._aviso_timer
        return False


class Aplicativo(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE | Gio.ApplicationFlags.NON_UNIQUE)

    def do_startup(self):
        Gtk.Application.do_startup(self)
        ak.aplicar_css(CSS)
        Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", True)

    def nova_janela(self, alvo):
        j = Janela(self, alvo or GLib.get_home_dir())
        j.show_all()
        j.progresso_barra.hide()
        j.present()
        return j

    def do_command_line(self, linha):
        args = [a for a in linha.get_arguments()[1:] if not a.startswith("-")]
        alvo = args[0] if args else GLib.get_home_dir()
        if alvo.startswith("file://"):
            alvo = unquote(urlparse(alvo).path)
        if os.path.isfile(alvo):
            alvo = os.path.dirname(alvo)
        self.nova_janela(alvo)
        return 0


if __name__ == "__main__":
    sys.exit(Aplicativo().run(sys.argv))
