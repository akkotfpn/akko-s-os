def data_txt(ts):
    return time.strftime("%d/%m/%Y %H:%M", time.localtime(ts))


def eh_elf(caminho):
    try:
        with open(caminho, "rb") as f:
            return f.read(4) == b"\x7fELF"
    except OSError:
        return False


def nome_unico(pasta, nome, sufixo_copia=True):
    """'a.txt' → 'a (cópia).txt' / 'Nova pasta' → 'Nova pasta (2)'."""
    alvo = os.path.join(pasta, nome)
    if not os.path.lexists(alvo):
        return alvo
    base, ext = os.path.splitext(nome)
    if os.path.isdir(alvo) or not sufixo_copia:
        base, ext = (nome, "") if os.path.isdir(alvo) else (base, ext)
    n = 1 if sufixo_copia else 2
    while True:
        if sufixo_copia:
            suf = " (cópia)" if n == 1 else f" (cópia {n})"
        else:
            suf = f" ({n})"
        alvo = os.path.join(pasta, f"{base}{suf}{ext}")
        if not os.path.lexists(alvo):
            return alvo
        n += 1


