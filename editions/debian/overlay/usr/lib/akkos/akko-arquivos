    def _menu(self, itens):
        menu = Gtk.Menu()
        for it in itens:
            if it is None:
                menu.append(Gtk.SeparatorMenuItem())
                continue
            rotulo, func = it[0], it[1]
            ativo = it[2] if len(it) > 2 else True
            if isinstance(func, list):
                mi = Gtk.MenuItem(label=rotulo)
                mi.set_submenu(self._menu(func))
            else:
                mi = Gtk.MenuItem(label=rotulo, use_underline=False)
                mi.connect("activate", lambda _m, f=func: f())
            mi.set_sensitive(ativo)
            menu.append(mi)
        menu.show_all()
        return menu

