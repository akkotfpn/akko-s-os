    def _carregar_prefs(self):
        kf = GLib.KeyFile()
        try:
            kf.load_from_file(PREFS, GLib.KeyFileFlags.NONE)
            self._visao_pref = kf.get_string("exibir", "visao")
            self.tamanho_icone = kf.get_integer("exibir", "icone") or self.tamanho_icone
            self.mostrar_ocultos = kf.get_boolean("exibir", "ocultos")
            if kf.get_boolean("exibir", "previa"):
                self.previa_revelar.set_reveal_child(True)
        except GLib.Error:
            self._visao_pref = "grade"
        if self._visao_pref not in ("grade", "lista"):
            self._visao_pref = "grade"
        self.grade.set_item_width(self.tamanho_icone + 48)

    def _salvar_prefs(self):
        kf = GLib.KeyFile()
        kf.set_string("exibir", "visao", self._visao_pref)
        kf.set_integer("exibir", "icone", self.tamanho_icone)
        kf.set_boolean("exibir", "ocultos", self.mostrar_ocultos)
        kf.set_boolean("exibir", "previa", self.previa_revelar.get_reveal_child())
        try:
            os.makedirs(os.path.dirname(PREFS), exist_ok=True)
            kf.save_to_file(PREFS)
        except (GLib.Error, OSError):
            pass

