    def _dispositivos_mudaram(self):
        self.drives = unidades(self.volumes)
        self._atualizar_lateral()
        if self.atual == COMPUTADOR:
            self._montar_computador()
        elif self.atual:
            self._atualizar_migalhas()

    def _atualizar_lateral(self):
        for filho in self.lateral.get_children():
            self.lateral.remove(filho)
        self.lateral.add(self._secao("Acesso rápido"))
        for icone, rotulo, caminho in pastas_pessoais():
            self.lateral.add(self._item_lateral(icone, rotulo, caminho))
        for caminho in ler_fixados():
            self.lateral.add(self._item_lateral("folder", os.path.basename(caminho) or caminho, caminho, fixado=True))
        self.lateral.add(self._secao("Este Computador"))
        self.lateral.add(self._item_lateral("computer", "Este Computador", COMPUTADOR))
        self.lateral.add(self._item_lateral("user-home", "Pasta pessoal", GLib.get_home_dir()))
        for d in self.drives:
            ejetar = None
            if d["volume"] and (d["volume"].can_eject() or (d["mount"] and d["mount"].can_unmount())):
                ejetar = (lambda v=d["volume"]: self._ejetar(v))
            elif d["mount"] and d["mount"].can_unmount():
                ejetar = (lambda m=d["mount"]: self._desmontar(m))
            alvo = d["caminho"] or ("volume", d["volume"])
            self.lateral.add(self._item_lateral(d["icone"], f"{d['nome']} ({d['letra']}:)", alvo, ejetar))
        prefixos = os.path.join(GLib.get_user_data_dir(), "akkos", "wine", "prefixos")
        if os.path.isdir(prefixos):
            self.lateral.add(self._secao("Windows"))
            padrao = os.path.join(prefixos, "padrao", "drive_c")
            self.lateral.add(self._item_lateral("wine", "Programas Windows (C: do Wine)",
                                                padrao if os.path.isdir(padrao) else prefixos))
        self.lateral.add(self._secao(""))
        self.lateral.add(self._item_lateral("user-trash", "Lixeira", LIXEIRA))
        self.lateral.show_all()

    def _lateral_ativada(self, _lb, linha):
        alvo = getattr(linha, "alvo", None)
        ak.tocar("click")
        if isinstance(alvo, tuple) and alvo[0] == "volume":
            self._montar_volume(alvo[1], abrir=True)
        elif alvo:
            self.navegar(alvo)

    def _clique_lateral(self, lb, ev):
        if ev.type != Gdk.EventType.BUTTON_PRESS or ev.button != 3:
            return False
        linha = lb.get_row_at_y(int(ev.y))
        alvo = getattr(linha, "alvo", None) if linha else None
        if not isinstance(alvo, str) or alvo.startswith(("trash:", "computador:")):
            return False
        itens = [("Abrir", lambda: self.navegar(alvo)),
                 ("Abrir em nova janela", lambda: self.get_application().nova_janela(alvo))]
        if getattr(linha, "fixado", False):
            itens.append(("Desafixar do Acesso rápido", lambda: self.desafixar(alvo)))
        itens += [None, ("Propriedades", lambda: self.propriedades([alvo]))]
        self._menu(itens).popup_at_pointer(ev)
        return True

    def fixar(self, caminho):
        lista = ler_fixados()
        if caminho not in lista:
            lista.append(caminho)
            gravar_fixados(lista)
        self._atualizar_lateral()

    def desafixar(self, caminho):
        gravar_fixados([c for c in ler_fixados() if c != caminho])
        self._atualizar_lateral()

    def _automontar(self, _mon, volume):
        if volume.should_automount() and volume.can_mount() and volume.get_mount() is None:
            self._montar_volume(volume, abrir=False)

    def _montar_volume(self, volume, abrir):
        def pronto(vol, res):
            try:
                vol.mount_finish(res)
            except GLib.Error as erro:
                if "already mounted" not in erro.message.lower():
                    self.avisar(f"Não foi possível abrir {vol.get_name()}: {erro.message}", erro=True)
                    return
            mount = vol.get_mount()
            if mount and abrir:
                self.navegar(mount.get_root().get_path())
            self._dispositivos_mudaram()
        volume.mount(Gio.MountMountFlags.NONE, Gtk.MountOperation.new(self), None, pronto)

    def _ejetar(self, volume):
        mount = volume.get_mount()
        if self.atual and mount and mount.get_root().get_path() and \
                self.atual.startswith(mount.get_root().get_path()):
            self.navegar(COMPUTADOR)

        def pronto(obj, res):
            try:
                (obj.eject_with_operation_finish if obj.can_eject() else obj.unmount_with_operation_finish)(res)
                self.avisar(f"{volume.get_name()} pode ser removido com segurança.")
                ak.tocar("notify")
            except GLib.Error as erro:
                self.avisar(f"Não foi possível remover {volume.get_name()}: {erro.message}", erro=True)
            self._dispositivos_mudaram()

        op = Gtk.MountOperation.new(self)
        if volume.can_eject():
            volume.eject_with_operation(Gio.MountUnmountFlags.NONE, op, None, pronto)
        elif mount:
            mount.unmount_with_operation(Gio.MountUnmountFlags.NONE, op, None, pronto)

    def _desmontar(self, mount):
        def pronto(m, res):
            try:
                m.unmount_with_operation_finish(res)
                ak.tocar("notify")
            except GLib.Error as erro:
                self.avisar(f"Não foi possível desmontar: {erro.message}", erro=True)
            self._dispositivos_mudaram()
        mount.unmount_with_operation(Gio.MountUnmountFlags.NONE, Gtk.MountOperation.new(self), None, pronto)

