def unidades(monitor):
    """Unidades no estilo Windows: C: = sistema; demais montagens e volumes
    (pendrives, outros discos) recebem D:, E:… na ordem em que aparecem."""
    def uso(caminho):
        try:
            st = os.statvfs(caminho)
            return st.f_blocks * st.f_frsize, st.f_bavail * st.f_frsize
        except OSError:
            return 0, 0
    total, livre = uso("/")
    lista = [{"letra": "C", "nome": "Disco Local", "caminho": "/", "total": total, "livre": livre,
              "icone": Gio.ThemedIcon.new("drive-harddisk"), "volume": None, "mount": None}]
    vistos = {"/"}
    letras = iter("DEFGHIJKLMNOPQRSTUVWXYZ")
    for vol in monitor.get_volumes():
        mount = vol.get_mount()
        caminho = mount.get_root().get_path() if mount else None
        if caminho in vistos:
            continue
        if caminho:
            vistos.add(caminho)
        t, lv = uso(caminho) if caminho else (0, 0)
        lista.append({"letra": next(letras, "?"), "nome": vol.get_name(), "caminho": caminho, "total": t,
                      "livre": lv, "icone": vol.get_icon(), "volume": vol, "mount": mount})
    for mount in monitor.get_mounts():
        caminho = mount.get_root().get_path()
        if not caminho or caminho in vistos or mount.is_shadowed() or mount.get_volume():
            continue
        vistos.add(caminho)
        t, lv = uso(caminho)
        lista.append({"letra": next(letras, "?"), "nome": mount.get_name(), "caminho": caminho, "total": t,
                      "livre": lv, "icone": mount.get_icon(), "volume": None, "mount": mount})
    return lista


ALIAS_DISPLAY = {"/home": "Usuários"}
ALIAS_ENTRADA = {"usuários": "home", "usuarios": "home", "users": "home"}


def para_windows(caminho, drives):
    """/home/akko/Docs → C:\\Usuários\\akko\\Docs ; /media/akko/PEN/x → D:\\x"""
    melhor = None
    for d in drives:
        c = d["caminho"]
        if c and (caminho == c or caminho.startswith(c.rstrip("/") + "/")):
            if melhor is None or len(c) > len(melhor["caminho"]):
                melhor = d
    if not melhor:
        return caminho
    resto = caminho[len(melhor["caminho"].rstrip("/")):].strip("/")
    partes = resto.split("/") if resto else []
    if melhor["letra"] == "C" and partes and partes[0] == "home":
        partes[0] = "Usuários"
    return f"{melhor['letra']}:\\" + "\\".join(partes)


def de_windows(texto, drives):
    """C:\\Usuários\\akko → /home/akko ; aceita / no lugar de \\. None se não for."""
    if len(texto) >= 2 and texto[1] == ":" and texto[0].isalpha():
        letra = texto[0].upper()
        d = next((d for d in drives if d["letra"] == letra and d["caminho"]), None)
        if not d:
            return None
        partes = [p for p in texto[2:].replace("\\", "/").split("/") if p]
        if letra == "C" and partes and partes[0].casefold() in ALIAS_ENTRADA:
            partes[0] = "home"
        return os.path.join(d["caminho"], *partes)
    return None


def ler_fixados():
