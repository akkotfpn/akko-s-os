    def _montar_atalhos(self):
        acoes = {
            "copiar": ("<Primary>c", lambda: self.copiar(False)),
            "recortar": ("<Primary>x", lambda: self.copiar(True)),
            "colar": ("<Primary>v", self.colar),
            "lixeira": ("Delete", self.mandar_lixeira),
            "excluir": ("<Shift>Delete", self.excluir_de_vez),
            "renomear": ("F2", self.renomear),
            "nova-pasta": ("<Primary><Shift>n", self.nova_pasta),
            "endereco": ("<Primary>l", lambda: (self.endereco.grab_focus(), self.endereco.select_region(0, -1))),
            "voltar": ("<Alt>Left", self.voltar),
            "avancar": ("<Alt>Right", self.avancar),
            "ocultos": ("<Primary>h", self.alternar_ocultos),
            "grade": ("<Primary>1", lambda: self.b_grade.set_active(True)),
            "lista": ("<Primary>2", lambda: self.b_lista.set_active(True)),
            "atualizar": ("F5", lambda: self.navegar(self.atual, registrar=False)),
            "buscar": ("<Primary>f", lambda: self.busca.grab_focus()),
            "previa": ("F9", lambda: self.b_previa.set_active(not self.b_previa.get_active())),
            "selecionar-tudo": ("<Primary>a", self.selecionar_tudo),
            "terminal": ("<Primary><Alt>t", self.abrir_terminal),
        }
        app = self.get_application()
        for nome, (tecla, func) in acoes.items():
            acao = Gio.SimpleAction.new(nome, None)
            acao.connect("activate", lambda _a, _p, f=func: f())
            self.add_action(acao)
            app.set_accels_for_action(f"win.{nome}", [tecla])
        self.connect("key-press-event", self._tecla)

    def _tecla(self, _w, ev):
        if ev.keyval == Gdk.KEY_BackSpace and not (self.endereco.has_focus() or self.busca.has_focus()):
            self.subir()
            return True
        if self.endereco.has_focus() or self.busca.has_focus():
            # nos campos de texto, Delete/Ctrl+C etc. são do campo, não dos arquivos:
            # entrega a tecla ao campo antes que os atalhos da janela a capturem
            if ev.keyval in (Gdk.KEY_Delete,) or (ev.state & Gdk.ModifierType.CONTROL_MASK and
                                                  ev.keyval in (Gdk.KEY_c, Gdk.KEY_x, Gdk.KEY_v, Gdk.KEY_a)):
                return self.propagate_key_event(ev)
        return False

