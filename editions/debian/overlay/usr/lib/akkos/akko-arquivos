def gfile_eh_executavel_elf(caminho):
    try:
        with open(caminho, "rb") as f:
            return f.read(4) == b"\x7fELF"
    except OSError:
        return False


def data_txt(ts):
    return time.strftime("%d/%m/%Y %H:%M", time.localtime(ts))


def nome_unico(destino_dir, nome):
    """'arquivo.txt' → 'arquivo (cópia).txt' → 'arquivo (cópia 2).txt'…"""
    alvo = os.path.join(destino_dir, nome)
    if not os.path.lexists(alvo):
        return alvo
    base, ext = os.path.splitext(nome)
    if os.path.isdir(alvo):
        base, ext = nome, ""
    n = 1
    while True:
        sufixo = " (cópia)" if n == 1 else f" (cópia {n})"
        alvo = os.path.join(destino_dir, f"{base}{sufixo}{ext}")
        if not os.path.lexists(alvo):
            return alvo
        n += 1


class Operacao:
    """Copiar/mover arquivos numa thread, reportando progresso para a interface."""

    def __init__(self, janela, origens, destino, mover):
        self.janela, self.origens, self.destino, self.mover = janela, origens, destino, mover
        self.total = sum(self._tamanho(o) for o in origens)
        self.feito = 0
        self.erros = []
        self.cancelar = False

    @staticmethod
    def _tamanho(caminho):
        if os.path.isdir(caminho) and not os.path.islink(caminho):
            total = 0
            for raiz, _dirs, arqs in os.walk(caminho):
                for a in arqs:
                    try:
                        total += os.lstat(os.path.join(raiz, a)).st_size
                    except OSError:
                        pass
            return total
        try:
            return os.lstat(caminho).st_size
        except OSError:
            return 0

    def _copiar_arquivo(self, src, dst):
        with open(src, "rb") as fi, open(dst, "wb") as fo:
            while not self.cancelar:
                bloco = fi.read(1 << 20)
                if not bloco:
                    break
                fo.write(bloco)
                self.feito += len(bloco)
                GLib.idle_add(self.janela.progresso, self)
        shutil.copystat(src, dst)

    def _copiar(self, src, dst):
        if os.path.islink(src):
            os.symlink(os.readlink(src), dst)
        elif os.path.isdir(src):
            os.mkdir(dst)
            for item in os.listdir(src):
                if self.cancelar:
                    return
                self._copiar(os.path.join(src, item), os.path.join(dst, item))
            shutil.copystat(src, dst)
        else:
            self._copiar_arquivo(src, dst)

    def executar(self):
        for origem in self.origens:
            if self.cancelar:
                break
            nome = os.path.basename(origem.rstrip("/"))
            try:
                if os.path.abspath(self.destino).startswith(os.path.abspath(origem) + os.sep) or \
                        os.path.abspath(self.destino) == os.path.abspath(origem):
                    raise OSError("não dá pra colocar uma pasta dentro dela mesma")
                if self.mover and os.path.dirname(os.path.abspath(origem)) == os.path.abspath(self.destino):
                    continue   # recortar e colar no mesmo lugar: nada a fazer
                alvo = nome_unico(self.destino, nome)
                if self.mover:
                    try:
                        os.rename(origem, alvo)   # mesmo disco: instantâneo
                        self.feito += self._tamanho(alvo)
                        continue
                    except OSError:
                        pass
                    self._copiar(origem, alvo)
                    if not self.cancelar:
                        shutil.rmtree(origem) if os.path.isdir(origem) and not os.path.islink(origem) else os.remove(origem)
                else:
                    self._copiar(origem, alvo)
            except OSError as erro:
                self.erros.append(f"{nome}: {erro.strerror or erro}")
        GLib.idle_add(self.janela.operacao_terminou, self)


