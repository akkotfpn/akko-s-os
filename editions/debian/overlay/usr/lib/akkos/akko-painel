        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.stick()

        barra = Gtk.Box(spacing=4, margin_start=6, margin_end=6)
        self.add(barra)

        self.botao_menu = Gtk.Button()
        self.botao_menu.set_tooltip_text("Aplicativos (tecla Super)")
        self.botao_menu.add(Gtk.Image.new_from_icon_name("akkos-logo", Gtk.IconSize.LARGE_TOOLBAR))
        self.botao_menu.connect("clicked", lambda b: (som_clique(), self.menu.alternar(self._x_de(b))))
        barra.pack_start(self.botao_menu, False, False, 0)

        self.tarefas = Gtk.Box(spacing=2)
        barra.pack_start(self.tarefas, True, True, 6)

