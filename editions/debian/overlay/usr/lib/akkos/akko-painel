class Popup(Gtk.Window):
    """Janela sem borda posicionada acima do painel; some ao perder o foco."""

    def __init__(self, painel, largura, altura):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.painel = painel
        self.get_style_context().add_class("popup")
        self.get_style_context().add_class("akkos")
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_default_size(largura, altura)
        self.largura, self.altura = largura, altura
        self.connect("focus-out-event", lambda *_: self.esconder())
        self.connect("key-press-event", self._tecla)

    def _tecla(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.esconder()
            return True
        return False

    def mostrar(self, x_ancora):
        geo = self.painel.geometria()
        x = min(max(geo.x + 8, x_ancora - self.largura // 2), geo.x + geo.width - self.largura - 8)
        y = geo.y + geo.height - ALTURA - self.altura - 8
        self.move(x, y)
        self.show_all()
        self.present_with_time(Gtk.get_current_event_time() or Gdk.CURRENT_TIME)
        self.get_window() and self.get_window().focus(Gdk.CURRENT_TIME)

    def esconder(self):
        self.hide()
        return False

    def alternar(self, x_ancora):
        if self.get_visible():
            self.esconder()
        else:
            self.mostrar(x_ancora)


class MenuApps(Popup):
    def __init__(self, painel):
        super().__init__(painel, 420, 560)
        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=12)
        topo = Gtk.Box(spacing=10)
        logo = Gtk.Image.new_from_icon_name("akkos-logo", Gtk.IconSize.DND)
        titulo = Gtk.Label(label="Akko's OS", xalign=0)
        titulo.get_style_context().add_class("akkos-titulo")
        topo.pack_start(logo, False, False, 0)
        topo.pack_start(titulo, True, True, 0)
        caixa.pack_start(topo, False, False, 0)

        self.busca = Gtk.SearchEntry(placeholder_text="Buscar aplicativos…")
        self.busca.get_style_context().add_class("akkos-campo")
        self.busca.connect("search-changed", lambda *_: self.lista.invalidate_filter())
        self.busca.connect("activate", self._abrir_primeiro)
        self.busca.connect("key-press-event", self._seta_baixo)
        caixa.pack_start(self.busca, False, False, 0)

        rolagem = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.lista = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE, activate_on_single_click=True)
        self.lista.set_filter_func(self._filtro)
        self.lista.set_header_func(self._cabecalho)
        self.lista.connect("row-activated", self._ativar)
        rolagem.add(self.lista)
        caixa.pack_start(rolagem, True, True, 0)
        self.add(caixa)

        self.monitor = Gio.AppInfoMonitor.get()
        self.monitor.connect("changed", lambda *_: self.recarregar())
        self.recarregar()

    def recarregar(self):
        for filho in self.lista.get_children():
            self.lista.remove(filho)
        apps = [a for a in Gio.AppInfo.get_all()
                if isinstance(a, Gio.DesktopAppInfo) and a.should_show()]
        itens = []
        for app in apps:
            cats = set((app.get_categories() or "").split(";"))
            if (app.get_executable() or "").startswith(("wine", "env")) or "wine" in (app.get_filename() or ""):
                cats.add("Wine")
            categoria = "Outros"
            for nome, conj in CATEGORIAS[1:]:
                if conj & cats:
                    categoria = nome
                    break
            itens.append((categoria, app))
            if app.get_id() in FAVORITOS:
                itens.append(("Favoritos", app))
        ordem = {n: i for i, (n, _) in enumerate(CATEGORIAS)}
        itens.sort(key=lambda it: (ordem.get(it[0], 99),
                                   FAVORITOS.index(it[1].get_id()) if it[0] == "Favoritos" else 0,
                                   it[1].get_display_name().casefold()))
        for categoria, app in itens:
            linha = Gtk.ListBoxRow()
            linha.app, linha.categoria = app, categoria
            linha.busca = " ".join(filter(None, [app.get_display_name(), app.get_generic_name() or "",
                                                  app.get_description() or "", " ".join(app.get_keywords() or [])])).casefold()
            caixa = Gtk.Box(spacing=12)
            caixa.get_style_context().add_class("item-app")
            icone = Gtk.Image.new_from_gicon(app.get_icon() or Gio.ThemedIcon.new("application-x-executable"),
                                             Gtk.IconSize.LARGE_TOOLBAR)
            icone.set_pixel_size(28)
            textos = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            nome = Gtk.Label(label=app.get_display_name(), xalign=0, ellipsize=Pango.EllipsizeMode.END)
            textos.pack_start(nome, False, False, 0)
            desc = app.get_generic_name() or app.get_description()
            if desc:
                d = Gtk.Label(label=desc, xalign=0, ellipsize=Pango.EllipsizeMode.END)
                d.get_style_context().add_class("akkos-muted")
                textos.pack_start(d, False, False, 0)
            caixa.pack_start(icone, False, False, 0)
            caixa.pack_start(textos, True, True, 0)
            linha.add(caixa)
            self.lista.add(linha)
        self.lista.show_all()

    def _buscando(self):
        return self.busca.get_text().strip().casefold()

    def _filtro(self, linha):
        termo = self._buscando()
        if not termo:
            return True
        return linha.categoria != "Favoritos" and all(p in linha.busca for p in termo.split())

    def _cabecalho(self, linha, anterior):
        if self._buscando():
            linha.set_header(None)
            return
        if anterior is None or anterior.categoria != linha.categoria:
            rotulo = Gtk.Label(label=linha.categoria.upper(), xalign=0)
            rotulo.get_style_context().add_class("categoria")
            linha.set_header(rotulo)
        else:
            linha.set_header(None)

    def _visiveis(self):
        return [l for l in self.lista.get_children() if l.get_child_visible() and self._filtro(l)]

    def _abrir_primeiro(self, *_):
        vis = self._visiveis()
        if vis:
            self._ativar(self.lista, vis[0])

    def _seta_baixo(self, _w, ev):
        if ev.keyval == Gdk.KEY_Down:
            vis = self._visiveis()
            if vis:
                self.lista.select_row(vis[0])
                vis[0].grab_focus()
            return True
        return False

    def _ativar(self, _lista, linha):
        ak.tocar("click")
        try:
            linha.app.launch([], Gdk.Display.get_default().get_app_launch_context())
        except GLib.Error:
            ak.tocar("error")
        self.esconder()

    def mostrar(self, x):
        self.busca.set_text("")
        super().mostrar(x)
        self.busca.grab_focus()


class PopupVolume(Popup):
    def __init__(self, painel):
        super().__init__(painel, 300, 110)
        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=14)
        topo = Gtk.Box(spacing=8)
        self.mudo = Gtk.ToggleButton()
        self.mudo.get_style_context().add_class("akkos-plano")
        self.icone = Gtk.Image.new_from_icon_name("audio-volume-high-symbolic", Gtk.IconSize.BUTTON)
        self.mudo.add(self.icone)
        self.mudo.connect("toggled", self._alternar_mudo)
        self.rotulo = Gtk.Label(label="Volume", xalign=0)
        topo.pack_start(self.mudo, False, False, 0)
        topo.pack_start(self.rotulo, True, True, 0)
        self.escala = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.escala.set_draw_value(False)
        self.escala.connect("value-changed", self._mudou)
        caixa.pack_start(topo, False, False, 0)
        caixa.pack_start(self.escala, False, False, 0)
        self.add(caixa)
        self._atualizando = False

    def mostrar(self, x):
        vol, mudo = ler_volume()
        self._atualizando = True
        self.escala.set_value(vol if vol is not None else 0)
        self.mudo.set_active(bool(mudo))
        self._atualizando = False
        self.rotulo.set_text("Volume" if vol is not None else "Sem saída de áudio")
        super().mostrar(x)

    def _mudou(self, escala):
        if self._atualizando:
            return
        definir_volume(int(escala.get_value()))
        self.painel.atualizar_volume()

    def _alternar_mudo(self, botao):
        if self._atualizando:
            return
        subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1" if botao.get_active() else "0"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.painel.atualizar_volume()


