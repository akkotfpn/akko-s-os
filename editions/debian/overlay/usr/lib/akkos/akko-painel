        botao_energia.set_tooltip_text("Energia")
        botao_energia.add(Gtk.Image.new_from_icon_name("system-shutdown-symbolic", Gtk.IconSize.BUTTON))
        botao_energia.connect("clicked", lambda b: (som_clique(), self.energia.alternar(self._x_de(b))))
