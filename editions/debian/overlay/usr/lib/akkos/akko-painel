def ler_volume():
    """(volume 0-100 ou None, mudo) da saída padrão, via wpctl."""
    try:
        saida = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], capture_output=True,
                               text=True, timeout=2).stdout
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return None, False
    m = re.search(r"Volume:\s*([\d.]+)", saida)
    if not m:
        return None, False
    return round(float(m.group(1)) * 100), "MUTED" in saida


def definir_volume(pct):
    subprocess.run(["wpctl", "set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SINK@", f"{pct}%"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


DIAS = ["segunda-feira", "terça-feira", "quarta-feira", "quinta-feira", "sexta-feira", "sábado", "domingo"]
MESES = ["janeiro", "fevereiro", "março", "abril", "maio", "junho", "julho", "agosto",
         "setembro", "outubro", "novembro", "dezembro"]


def data_por_extenso(dt):
    return f"{DIAS[dt.get_day_of_week() - 1].capitalize()}, {dt.get_day_of_month()} de {MESES[dt.get_month() - 1]}"


