        self.volume = PopupVolume(self)
        self.calendario = PopupRelogio(self)
        self.energia = PopupEnergia(self)

        self._posicionar()
        Gdk.Screen.get_default().connect("monitors-changed", lambda *_: self._posicionar())
        self.connect("realize", lambda *_: self._reservar_espaco())

        self._iniciar_janelas()
        self._iniciar_rede()
        self._iniciar_montagem()
        self.atualizar_relogio()
        GLib.timeout_add_seconds(1, self.atualizar_relogio)
        self.atualizar_volume()
        GLib.timeout_add_seconds(3, lambda: self.atualizar_volume() or True)

    # --- geometria -----------------------------------------------------------

    def geometria(self):
        display = Gdk.Display.get_default()
        mon = display.get_primary_monitor() or display.get_monitor(0)
        return mon.get_geometry()

    def _posicionar(self):
        geo = self.geometria()
        self.set_size_request(geo.width, ALTURA)
        self.resize(geo.width, ALTURA)
        self.move(geo.x, geo.y + geo.height - ALTURA)
        self._reservar_espaco()

    def _reservar_espaco(self):
        """Pede ao gerenciador de janelas para não cobrir o painel
        (_NET_WM_STRUT_PARTIAL). O Openbox também tem margem configurada."""
        janela = self.get_window()
        if not janela:
            return
        geo = self.geometria()
        tela_altura = Gdk.Screen.get_default().get_height()
        fundo = tela_altura - (geo.y + geo.height) + ALTURA
        try:
            subprocess.run(["xprop", "-id", str(janela.get_xid()), "-f", "_NET_WM_STRUT_PARTIAL", "32c",
                            "-set", "_NET_WM_STRUT_PARTIAL",
                            f"0, 0, 0, {fundo}, 0, 0, 0, 0, 0, 0, {geo.x}, {geo.x + geo.width - 1}"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
        except (FileNotFoundError, subprocess.TimeoutExpired, AttributeError):
            pass

    def _x_de(self, widget):
        janela = self.get_window()
        _, ox, _ = janela.get_origin() if janela else (0, 0, 0)
        aloc = widget.get_allocation()
        return ox + aloc.x + aloc.width // 2

    def abrir_menu(self):
        self.menu.alternar(self._x_de(self.botao_menu))

    # --- relógio e volume ------------------------------------------------------

    def atualizar_relogio(self):
        agora = GLib.DateTime.new_now_local()
        self.relogio.set_text(agora.format("%H:%M"))
        self.botao_relogio.set_tooltip_text(data_por_extenso(agora) + agora.format(" de %Y"))
        return True

    def atualizar_volume(self):
        vol, mudo = ler_volume()
        if vol is None:
            nome, dica = "audio-volume-muted-symbolic", "Sem saída de áudio"
        elif mudo or vol == 0:
            nome, dica = "audio-volume-muted-symbolic", "Mudo"
        elif vol < 34:
            nome, dica = "audio-volume-low-symbolic", f"Volume {vol}%"
        elif vol < 67:
            nome, dica = "audio-volume-medium-symbolic", f"Volume {vol}%"
        else:
            nome, dica = "audio-volume-high-symbolic", f"Volume {vol}%"
        self.icone_vol.set_from_icon_name(nome, Gtk.IconSize.BUTTON)
        self.botao_vol.set_tooltip_text(dica)

    def _rolar_volume(self, _w, ev):
        vol, _ = ler_volume()
        if vol is None:
            return True
        if ev.direction == Gdk.ScrollDirection.SMOOTH:
            passo = -5 if ev.delta_y > 0 else 5
        else:
            passo = 5 if ev.direction == Gdk.ScrollDirection.UP else -5
        definir_volume(max(0, min(100, vol + passo)))
        self.atualizar_volume()
        return True

    # --- lista de janelas ---------------------------------------------------------

    def _iniciar_janelas(self):
        self.tela = Wnck.Screen.get_default()
        self.botoes = {}
        for sinal in ("window-opened", "window-closed", "active-window-changed"):
            self.tela.connect(sinal, lambda *_: self._atualizar_tarefas())
        self.tela.force_update()
        self._atualizar_tarefas()

    def _atualizar_tarefas(self):
        ativa = self.tela.get_active_window()
        atuais = [j for j in self.tela.get_windows()
                  if j.get_window_type() in (Wnck.WindowType.NORMAL, Wnck.WindowType.DIALOG)
                  and not j.is_skip_tasklist()]
        for xid in list(self.botoes):
            if xid not in {j.get_xid() for j in atuais}:
                self.botoes.pop(xid).destroy()
        for j in atuais:
            xid = j.get_xid()
            if xid not in self.botoes:
                self.botoes[xid] = self._criar_botao_tarefa(j)
            b = self.botoes[xid]
            ctx = b.get_style_context()
            for classe, ligada in (("ativa", ativa is not None and ativa.get_xid() == xid),
                                   ("minimizada", j.is_minimized())):
                (ctx.add_class if ligada else ctx.remove_class)(classe)
        largura = max(90, min(220, (self.geometria().width - 420) // max(1, len(atuais))))
        for b in self.botoes.values():
            b.set_size_request(largura, -1)

    def _criar_botao_tarefa(self, janela):
        b = Gtk.Button()
        b.get_style_context().add_class("tarefa")
        caixa = Gtk.Box(spacing=6)
        icone = Gtk.Image()
        rotulo = Gtk.Label(ellipsize=Pango.EllipsizeMode.END, xalign=0)

        def atualizar(*_):
            pix = janela.get_mini_icon()
            if pix:
                icone.set_from_pixbuf(pix)
            rotulo.set_text(janela.get_name())
            b.set_tooltip_text(janela.get_name())

        janela.connect("name-changed", atualizar)
        janela.connect("icon-changed", atualizar)
        janela.connect("state-changed", lambda *_: self._atualizar_tarefas())
        atualizar()
        caixa.pack_start(icone, False, False, 0)
        caixa.pack_start(rotulo, True, True, 0)
        b.add(caixa)

        def clicar(_b):
            ak.tocar("click")
            t = Gtk.get_current_event_time() or int(time.time())
            if janela.is_active() and not janela.is_minimized():
                janela.minimize()
            else:
                janela.activate(t)

        b.connect("clicked", clicar)
        self.tarefas.pack_start(b, False, False, 0)
        b.show_all()
        return b

    # --- rede -----------------------------------------------------------------------

    def _iniciar_rede(self):
        try:
            self.nm = NM.Client.new(None)
        except GLib.Error:
            self.nm = None
            self.botao_rede.set_tooltip_text("NetworkManager indisponível")
            return
        for sinal in ("notify::primary-connection", "notify::state", "notify::connectivity"):
            self.nm.connect(sinal, lambda *_: self._atualizar_rede())
        GLib.timeout_add_seconds(5, lambda: self._atualizar_rede() or True)
        self._atualizar_rede()

    def _atualizar_rede(self):
        if not self.nm:
            return
        ativa = self.nm.get_primary_connection()
        if ativa is None or self.nm.get_state() < NM.State.CONNECTED_LOCAL:
            self.icone_rede.set_from_icon_name("network-offline-symbolic", Gtk.IconSize.BUTTON)
            self.botao_rede.set_tooltip_text("Desconectado — clique para conectar")
            return
        nome = ativa.get_id()
        ip = ""
        cfg = ativa.get_ip4_config()
        if cfg and cfg.get_addresses():
            ip = cfg.get_addresses()[0].get_address()
        sem_internet = self.nm.get_connectivity() in (NM.ConnectivityState.LIMITED, NM.ConnectivityState.NONE)
        if ativa.get_connection_type() == "802-11-wireless":
            sinal = 0
            for dev in ativa.get_devices():
                if isinstance(dev, NM.DeviceWifi) and dev.get_active_access_point():
                    sinal = dev.get_active_access_point().get_strength()
            nivel = "excellent" if sinal > 75 else "good" if sinal > 50 else "ok" if sinal > 25 else "weak"
            icone = f"network-wireless-signal-{nivel}-symbolic"
        else:
            icone = "network-wired-symbolic"
        if sem_internet:
            icone = "network-wired-no-route-symbolic" if "wired" in icone else "network-wireless-no-route-symbolic"
        self.icone_rede.set_from_icon_name(icone, Gtk.IconSize.BUTTON)
        dica = f"{nome}" + (f" — {ip}" if ip else "") + (" (sem internet)" if sem_internet else "")
        self.botao_rede.set_tooltip_text(dica)

    # --- pendrives ------------------------------------------------------------------

    def _iniciar_montagem(self):
        self.volumes = Gio.VolumeMonitor.get()
        self.volumes.connect("volume-added", self._volume_novo)

    def _volume_novo(self, _mon, volume):
        if not volume.can_mount() or volume.get_mount() is not None or not volume.should_automount():
            return
        operacao = Gtk.MountOperation.new(self)

        def montado(vol, resultado):
            try:
                vol.mount_finish(resultado)
            except GLib.Error as erro:
                ak.tocar("error")
                cmd(["notify-send", "-i", "drive-removable-media", "Não foi possível abrir o dispositivo",
                     f"{vol.get_name()}: {erro.message}"])
                return
            mount = vol.get_mount()
            caminho = mount.get_root().get_path() if mount else ""
            cmd(["notify-send", "-i", "drive-removable-media", f"{vol.get_name()} conectado",
                 f"Disponível em Arquivos{(' — ' + caminho) if caminho else ''}"])

        volume.mount(Gio.MountMountFlags.NONE, operacao, None, montado)


class Aplicativo(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.janela = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        ak.aplicar_css(CSS)
        Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", True)

    def do_command_line(self, linha):
        args = linha.get_arguments()[1:]
        if self.janela is None:
            self.janela = Painel(self)
            self.janela.show_all()
        if "--menu" in args:
            self.janela.abrir_menu()
        return 0


if __name__ == "__main__":
    sys.exit(Aplicativo().run(sys.argv))
