        self.icone_vol = Gtk.Image.new_from_icon_name("audio-volume-high-symbolic", Gtk.IconSize.BUTTON)
        self.botao_vol.add(self.icone_vol)
        self.botao_vol.connect("clicked", lambda b: (som_clique(), self.volume.alternar(self._x_de(b))))
        self.botao_vol.add_events(Gdk.EventMask.SCROLL_MASK | Gdk.EventMask.SMOOTH_SCROLL_MASK)
        self.botao_vol.connect("scroll-event", self._rolar_volume)
        barra.pack_start(self.botao_vol, False, False, 0)

        self.botao_relogio = Gtk.Button()
        self.relogio = Gtk.Label()
        self.relogio.get_style_context().add_class("relogio")
        self.botao_relogio.add(self.relogio)
